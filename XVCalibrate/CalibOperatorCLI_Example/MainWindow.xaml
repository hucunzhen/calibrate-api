<Window x:Class="CalibOperatorCLI_Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工业视觉标定工具"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource NavBarBrush}" Padding="0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="NavPlc" Content="PLC" Style="{StaticResource NavTabButtonStyle}"
                        Click="NavPlc_Click"
                        AutomationProperties.Name="PLC"/>
                <Button x:Name="NavHistogram" Content="直方图" Style="{StaticResource NavTabButtonStyle}"
                        Click="NavHistogram_Click"
                        AutomationProperties.Name="直方图"/>
                <Button x:Name="NavFlow" Content="组态" Style="{StaticResource NavTabButtonStyle}"
                        Click="NavFlow_Click"
                        AutomationProperties.Name="组态流程"/>
                <Button x:Name="NavYoloSeg" Content="YOLO分割" Style="{StaticResource NavTabButtonStyle}"
                        Click="NavYoloSeg_Click"
                        AutomationProperties.Name="YOLO分割训练"/>
                <Button x:Name="NavSamOnnx" Content="SAM ONNX" Style="{StaticResource NavTabButtonStyle}"
                        Click="NavSamOnnx_Click"
                        AutomationProperties.Name="SAM ONNX 导出"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource NavAccentBrush}"/>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>
