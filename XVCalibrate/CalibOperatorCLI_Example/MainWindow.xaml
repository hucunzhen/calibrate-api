<Window x:Class="CalibOperatorCLI_Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工业视觉标定工具"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource NavBarBrush}" Padding="0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="NavPlc" Content="PLC" Style="{StaticResource NavTabButtonStyle}"
                        Click="NavPlc_Click"
                        AutomationProperties.Name="PLC"/>
                <Button x:Name="NavFlow" Content="组态" Style="{StaticResource NavTabButtonStyle}"
                        Click="NavFlow_Click"
                        AutomationProperties.Name="组态流程"/>
                <Button x:Name="NavAdvanced" Content="高级功能 ▾" Style="{StaticResource NavTabButtonStyle}"
                        MinWidth="108"
                        Click="NavAdvanced_Click"
                        AutomationProperties.Name="高级功能">
                    <Button.ContextMenu>
                        <ContextMenu Background="#2D2D2D" BorderBrush="#555" BorderThickness="1">
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#2D2D2D"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#404040"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ContextMenu.Resources>
                            <MenuItem Header="直方图" Click="NavHistogram_Click"
                                      AutomationProperties.Name="直方图"/>
                            <MenuItem Header="YOLO分割" Click="NavYoloSeg_Click"
                                      AutomationProperties.Name="YOLO分割训练"/>
                            <MenuItem Header="SAM ONNX" Click="NavSamOnnx_Click"
                                      AutomationProperties.Name="SAM ONNX 导出"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource NavAccentBrush}"/>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>
