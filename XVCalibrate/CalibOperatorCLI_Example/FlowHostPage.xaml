<Page x:Class="CalibOperatorCLI_Example.FlowHostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="组态流程"
      Background="#252526">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource NavBarBrush}"
                Padding="0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="NewTabButton"
                        Content="＋ 新建标签"
                        Style="{StaticResource NavBarActionButtonStyle}"
                        Click="NewTabButton_Click"
                        AutomationProperties.Name="新建组态标签"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource NavAccentBrush}"/>

        <TabControl x:Name="FlowTabs"
                    Style="{StaticResource FlowHostTabControlStyle}"
                    ItemContainerStyle="{StaticResource FlowHostTabItemStyle}"/>
    </DockPanel>
</Page>
