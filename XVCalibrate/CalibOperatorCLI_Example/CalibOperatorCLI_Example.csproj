<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- HALCON：未安装时跳过引用与算子（可通过 msbuild -p:HalconRoot=... 覆盖路径） -->
  <PropertyGroup>
    <HalconRoot Condition="'$(HalconRoot)'==''">C:\Users\WGDQ\AppData\Local\Programs\MVTec\HALCON-25.11-Progress</HalconRoot>
  </PropertyGroup>
  <PropertyGroup>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRoot)\bin\dotnet50\HalconDotNet.dll')">$(HalconRoot)\bin\dotnet50\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRoot)\bin\dotnet45\HalconDotNet.dll')">$(HalconRoot)\bin\dotnet45\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRoot)\bin\dotnet40\HalconDotNet.dll')">$(HalconRoot)\bin\dotnet40\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRoot)\bin\dotnet35\HalconDotNet.dll')">$(HalconRoot)\bin\dotnet35\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRoot)\bin\dotnetcore31\HalconDotNet.dll')">$(HalconRoot)\bin\dotnetcore31\HalconDotNet.dll</HalconDotNetDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HalconDotNetDll)' != ''">
    <DefineConstants>$(DefineConstants);HALCON_ENABLED</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HalconDotNetDll)' != ''">
    <Reference Include="HalconDotNet">
      <HintPath>$(HalconDotNetDll)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HalconDotNetDll)' == ''">
    <Compile Remove="HalconFlowBridge.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="HslCommunication" Version="12.7.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.0" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\YoloSeg_Tools\auto_label_seg.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>YoloSeg_Tools\auto_label_seg.py</Link>
    </None>
    <None Include="..\..\YoloSeg_Tools\train_seg.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>YoloSeg_Tools\train_seg.py</Link>
    </None>
    <None Include="..\..\YoloSeg_Tools\predict_seg.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>YoloSeg_Tools\predict_seg.py</Link>
    </None>
    <None Include="..\..\YoloSeg_Tools\requirements-yolo-seg.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>YoloSeg_Tools\requirements-yolo-seg.txt</Link>
    </None>
  </ItemGroup>

  <!-- PLC 配置文件复制到输出目录 -->
  <ItemGroup>
    <None Include="plc_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 海康威视相机 SDK -->
  <ItemGroup>
    <Reference Include="MvCameraControl.Net">
      <HintPath>..\..\Development\DotNet\win64\netstandard2.0\MvCameraControl.Net.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- 复制依赖的 DLL 到输出目录 -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="..\..\bin\x64\Debug\CalibOperatorNative.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>CalibOperatorNative.dll</Link>
    </None>
    <None Include="..\..\bin\x64\Debug\CalibOperatorNative.pdb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>CalibOperatorNative.pdb</Link>
    </None>
    <None Include="..\..\opencv\build\x64\vc16\bin\opencv_world4130d.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="..\..\bin\x64\Release\CalibOperatorNative.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>CalibOperatorNative.dll</Link>
    </None>
    <None Include="..\..\opencv_world4130.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EnableUnmanagedDebugging>true</EnableUnmanagedDebugging>
  </PropertyGroup>

  <!-- HALCON x64 原生 DLL（与 exe 同目录，供 halconxl 等加载） -->
  <Target Name="CopyHalconNativeDlls" AfterTargets="Build" Condition="Exists('$(HalconRoot)\bin\x64-win64')">
    <ItemGroup>
      <_HalconNative Include="$(HalconRoot)\bin\x64-win64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_HalconNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- 编译后自动复制海康 MVS Runtime 原生 DLL -->
  <Target Name="CopyMvsRuntime" AfterTargets="Build" Condition="'$(PlatformTarget)' == 'x64'">
    <PropertyGroup>
      <MvsRuntimeDir Condition="Exists('$(ProgramFiles(x86))\Common Files\MVS\Runtime\Win64_x64')">$(ProgramFiles(x86))\Common Files\MVS\Runtime\Win64_x64</MvsRuntimeDir>
      <MvsRuntimeDir Condition="Exists('D:\MVS\Development\Bin') == 'false' and '$(MvsRuntimeDir)' == ''">$(MvsRuntimeDir)</MvsRuntimeDir>
    </PropertyGroup>
    <ItemGroup>
      <MvsDll Include="$(MvsRuntimeDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(MvsDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'$(MvsRuntimeDir)' != ''" />
  </Target>
</Project>