<Window x:Class="CalibOperatorCLI_Example.RecipeNameInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配方名称"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#252526"
        Foreground="White"
        ShowInTaskbar="False">
    <StackPanel Margin="16" MinWidth="320">
        <TextBlock x:Name="TxtPrompt" Text="新配方名称" Foreground="#CCCCCC"/>
        <TextBox x:Name="TxtName" Margin="0,8,0,0" Height="28" Padding="6,4"
                 VerticalContentAlignment="Center"/>
        <TextBlock x:Name="TxtError" Text="" Foreground="#F48771" FontSize="11"
                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" IsDefault="True" MinWidth="72" Height="28" Margin="0,0,8,0"
                    Padding="10,2" Click="Ok_Click"/>
            <Button Content="取消" IsCancel="True" MinWidth="72" Height="28" Padding="10,2"/>
        </StackPanel>
    </StackPanel>
</Window>
