<Window x:Class="CalibOperatorCLI_Example.ChangeoverWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="换产品标定与部署"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Ui.WorkspaceBackground}"
        Foreground="{StaticResource Ui.TextPrimary}">
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Ui.DarkLabel}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource Ui.DarkCheckBox}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnSave" Content="保存并关闭" Style="{StaticResource IndustrialToolbarPrimaryButton}"
                    MinWidth="100" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Content="取消" IsCancel="True" Style="{StaticResource IndustrialToolbarButton}" MinWidth="80"/>
        </StackPanel>
        <CheckBox x:Name="ChkProductionReleased" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                  Foreground="{StaticResource Ui.TextPrimary}"
                  Content="验收完成，允许操作员量产运行" FontWeight="SemiBold" FontSize="13"/>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="换型检查清单（阶段 0–6）" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Ui.SectionTitle}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ui.TextSecondary}" FontSize="12"
                       Text="按产线 SOP 逐项勾选。每阶段可点「说明」查看操作步骤。全部完成并勾选「允许量产」后，操作员方可启动主流程。"/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Ui.CardDark}" BorderBrush="{StaticResource Ui.PanelBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                <StackPanel x:Name="StagePanel"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
