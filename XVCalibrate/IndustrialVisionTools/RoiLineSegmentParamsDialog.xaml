<Window x:Class="CalibOperatorCLI_Example.RoiLineSegmentParamsDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="直线段参数"

        SizeToContent="WidthAndHeight"

        ResizeMode="NoResize"

        WindowStartupLocation="CenterOwner"

        Background="#2D2D30"

        Foreground="#E0E0E0"

        ShowInTaskbar="False">

    <Border Padding="16" MinWidth="380">

        <StackPanel>

            <TextBlock x:Name="TxtDirectionHint" Text="已用鼠标选定方向。" TextWrapping="Wrap" Margin="0,0,0,8"

                       Foreground="#B0BEC5" FontSize="12"/>

            <TextBlock x:Name="TxtAnchorHint" Text="" FontSize="10" Foreground="#888" TextWrapping="Wrap"

                       Margin="0,0,0,10"/>

            <TextBlock Text="方向角（图像系：0°沿 +X，逆时针为正）" FontWeight="SemiBold" Margin="0,0,0,4"/>

            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="52"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="24"/>

                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="角度" VerticalAlignment="Center"/>

                <TextBox x:Name="TxtAngleDeg" Grid.Column="1" Height="26" Margin="0,0,8,0"

                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="°" VerticalAlignment="Center"/>

            </Grid>

            <TextBlock Text="段长 L" FontWeight="SemiBold" Margin="0,0,0,4"/>

            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="52"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="36"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="像素" VerticalAlignment="Center"/>

                <TextBox x:Name="TxtLengthPx" Grid.Column="1" Height="26" Margin="0,0,8,0"

                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center"/>

                <TextBox x:Name="TxtLengthMm" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>

            </Grid>

            <TextBlock Text="终点坐标（修改后自动反算段长与角度）" FontWeight="SemiBold" Margin="0,0,0,4"/>

            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="56"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="56"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="列 X" VerticalAlignment="Center"/>

                <TextBox x:Name="TxtEndColPx" Grid.Column="1" Height="26" Margin="0,0,8,0"

                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="行 Y" VerticalAlignment="Center"/>

                <TextBox x:Name="TxtEndRowPx" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>

            </Grid>

            <TextBlock x:Name="TxtMmStatus" Text="" FontSize="10" Foreground="#888" TextWrapping="Wrap"

                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="确定" Width="72" Height="28" Margin="0,0,8,0" IsDefault="True"

                        Click="BtnOk_Click"/>

                <Button Content="取消" Width="72" Height="28" IsCancel="True"/>

            </StackPanel>

        </StackPanel>

    </Border>

</Window>

