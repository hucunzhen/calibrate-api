<Window x:Class="CalibOperatorCLI_Example.RoiPointLandingDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="落点坐标"

        SizeToContent="WidthAndHeight"

        ResizeMode="NoResize"

        WindowStartupLocation="CenterOwner"

        Background="#2D2D30"

        Foreground="#E0E0E0"

        ShowInTaskbar="False">

    <Border Padding="16" MinWidth="360">

        <StackPanel>

            <TextBlock x:Name="TxtHint" Text="可修改落点列、行坐标（图像像素）。" TextWrapping="Wrap"

                       Margin="0,0,0,12" Foreground="#B0BEC5" FontSize="12"/>

            <TextBlock Text="图像坐标" FontWeight="SemiBold" Margin="0,0,0,4"/>

            <Grid Margin="0,0,0,8">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="56"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="56"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="列 X" VerticalAlignment="Center" ToolTip="列坐标（像素）"/>

                <TextBox x:Name="TxtColPx" Grid.Column="1" Height="26" Margin="0,0,8,0"

                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="行 Y" VerticalAlignment="Center" ToolTip="行坐标（像素）"/>

                <TextBox x:Name="TxtRowPx" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>

            </Grid>

            <TextBlock x:Name="TxtWorldHint" Text="" FontSize="10" Foreground="#888" TextWrapping="Wrap"

                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="确定" Width="72" Height="28" Margin="0,0,8,0" IsDefault="True"

                        Click="BtnOk_Click"/>

                <Button Content="取消" Width="72" Height="28" IsCancel="True"/>

            </StackPanel>

        </StackPanel>

    </Border>

</Window>

