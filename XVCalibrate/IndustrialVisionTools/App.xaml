<Application x:Class="CalibOperatorCLI_Example.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 工业视觉 · 深色工作区 + 浅色配置页 -->
        <SolidColorBrush x:Key="Ui.PageBackground" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="Ui.CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ui.CardBorder" Color="#CFD8DC"/>
        <SolidColorBrush x:Key="Ui.StatusBarBg" Color="#1E2430"/>
        <SolidColorBrush x:Key="Ui.StatusBarFg" Color="#B0BEC5"/>
        <SolidColorBrush x:Key="Ui.StatusBarBorder" Color="#3D4654"/>
        <SolidColorBrush x:Key="Ui.LogConsoleFg" Color="#C5CED8"/>
        <SolidColorBrush x:Key="Ui.Accent" Color="#0095B6"/>

        <!-- 深色编排 / 模板工作区 -->
        <SolidColorBrush x:Key="Ui.WorkspaceBackground" Color="#1A1D23"/>
        <SolidColorBrush x:Key="Ui.PanelBackground" Color="#232830"/>
        <SolidColorBrush x:Key="Ui.PanelBorder" Color="#3D4654"/>
        <SolidColorBrush x:Key="Ui.CardDark" Color="#2A3140"/>
        <SolidColorBrush x:Key="Ui.InputBackground" Color="#1E2430"/>
        <SolidColorBrush x:Key="Ui.InputBorder" Color="#4A5568"/>
        <SolidColorBrush x:Key="Ui.TextPrimary" Color="#E8ECF1"/>
        <SolidColorBrush x:Key="Ui.TextSecondary" Color="#9AA5B5"/>
        <SolidColorBrush x:Key="Ui.TextMuted" Color="#6B7785"/>
        <SolidColorBrush x:Key="Ui.SectionTitle" Color="#7EC8E3"/>
        <SolidColorBrush x:Key="Ui.Success" Color="#3DAA6D"/>
        <SolidColorBrush x:Key="Ui.Warning" Color="#E6A23C"/>
        <SolidColorBrush x:Key="Ui.Danger" Color="#E05555"/>

        <!-- 主导航 -->
        <SolidColorBrush x:Key="NavBarBrush" Color="#1E2430"/>
        <SolidColorBrush x:Key="NavHoverBrush" Color="#2C3544"/>
        <SolidColorBrush x:Key="NavAccentBrush" Color="#0095B6"/>
        <SolidColorBrush x:Key="NavTextBrush" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="NavTextMutedBrush" Color="#8A97A8"/>

        <!-- 悬停提示（全局深色，便于产线阅读） -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource Ui.CardDark}"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="380"/>
        </Style>

        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,4">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="ActiveBar" Height="3" VerticalAlignment="Bottom"
                                        Background="{StaticResource NavAccentBrush}" CornerRadius="2"
                                        Margin="8,0" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <!-- 流程编排 · 工具栏 -->
        <Style x:Key="FlowToolbarIconBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource Ui.CardDark}"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#354052"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlowToolbarPrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource FlowToolbarIconBtnStyle}">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style x:Key="FlowToolbarRunBtnStyle" TargetType="Button" BasedOn="{StaticResource FlowToolbarPrimaryBtnStyle}">
            <Setter Property="Background" Value="#0D5C6F"/>
            <Setter Property="BorderBrush" Value="#0095B6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#117A92"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 工业卡片 / 分区标题 -->
        <Style x:Key="Ui.SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.SectionTitle}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Ui.CardDarkStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ui.CardDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="Ui.DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Ui.InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Ui.DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#354052"/>
                                <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#117A92"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 须在 Ui.DarkComboBoxTemplate 之前：StaticResource 不能后向引用 -->
        <DataTemplate x:Key="Ui.DarkComboBoxSelectionBoxItem">
            <TextBlock TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ui.TextPrimary}">
                <TextBlock.Text>
                    <PriorityBinding FallbackValue="">
                        <Binding Path="Content"/>
                        <Binding/>
                    </PriorityBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <ControlTemplate x:Key="Ui.DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="Transparent" SnapsToDevicePixels="True"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#2A3140"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#354052"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="Ui.DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Chrome"
                        Grid.ColumnSpan="2"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"/>
                <ToggleButton x:Name="ToggleButton"
                              Grid.ColumnSpan="2"
                              Focusable="False"
                              ClickMode="Press"
                              Template="{StaticResource Ui.DarkComboBoxToggleButton}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter x:Name="ContentSite"
                                  Grid.Column="0"
                                  Margin="8,4,28,4"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{StaticResource Ui.DarkComboBoxSelectionBoxItem}"
                                  TextElement.Foreground="{StaticResource Ui.TextPrimary}"
                                  IsHitTestVisible="False"/>
                <Path Grid.Column="1" Width="8" Height="5" Margin="0,0,6,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Data="M 0,0 L 4,4 L 8,0 Z" Fill="{StaticResource Ui.TextSecondary}"
                      IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                       Focusable="False">
                    <Border x:Name="DropDownBorder"
                            Background="{StaticResource Ui.InputBackground}"
                            BorderBrush="{StaticResource Ui.InputBorder}"
                            BorderThickness="1"
                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer SnapsToDevicePixels="True" Padding="2">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{StaticResource Ui.TextMuted}"/>
                    <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Ui.DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Ui.InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Ui.DarkComboBoxItem}"/>
            <Setter Property="Template" Value="{StaticResource Ui.DarkComboBoxTemplate}"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E2430"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8ECF1"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E2430"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E8ECF1"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#117A92"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
            </Style.Resources>
        </Style>

        <Style x:Key="Ui.DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BoxBorder" Width="16" Height="16" CornerRadius="2"
                                    Background="{StaticResource Ui.InputBackground}"
                                    BorderBrush="{StaticResource Ui.InputBorder}" BorderThickness="1"
                                    VerticalAlignment="Center"/>
                            <Path x:Name="CheckMark" Grid.Column="0" Width="10" Height="8"
                                  Data="M 0,4 L 3,7 L 9,0" Stroke="{StaticResource Ui.SectionTitle}"
                                  StrokeThickness="2" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource NavAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource NavAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
                                <Setter TargetName="BoxBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ui.DarkListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#354052"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#117A92"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ui.DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Ui.InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Ui.DarkListBoxItem}"/>
        </Style>

        <Style x:Key="Ui.DarkLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
        </Style>

        <Style x:Key="IndustrialToolbarButton" TargetType="Button">
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="{StaticResource Ui.CardDark}"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#354052"/>
                    <Setter Property="BorderBrush" Value="{StaticResource NavAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndustrialToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource IndustrialToolbarButton}">
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#0D5C6F"/>
            <Setter Property="BorderBrush" Value="#0095B6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#117A92"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlowHostTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource NavBarBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" Margin="0,0,2,0" CornerRadius="4,4,0,0">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.PanelBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ui.SectionTitle}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlowHostTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Ui.WorkspaceBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Application.Resources>
</Application>
