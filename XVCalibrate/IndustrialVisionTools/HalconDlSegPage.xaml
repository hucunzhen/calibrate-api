<Page x:Class="CalibOperatorCLI_Example.HalconDlSegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HALCON 深度学习分割"
      Background="{StaticResource Ui.PageBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="160" MinHeight="120"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="8">
            <StackPanel>
                <TextBlock Text="HALCON 语义分割（数据来自已有 YOLO 标注）" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0,0,0,12"
                           Text="① 使用与「YOLO分割」相同的数据集根目录（images/train、labels/train 多边形 txt）。② 导出将生成 segmentation PNG 与 halcon_dl_dataset_spec.json（flat 的 images/、segmentation/）。③ 若已启用 HalconDotNet，可直接用下方「训练」调用 train_dl_model_batch 微调（预处理仅为缩放；与官方 preprocess_dl_dataset 不一致时请改用 HDevelop）。④ 推理使用已训练 .hdl。"/>

                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="数据集与导出" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="数据集根目录" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtDatasetRoot" Grid.Column="1" Height="24" Margin="4,0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="浏览…" Width="72" Height="26" Margin="4,0,0,0" Click="BtnBrowseDataset_Click"/>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="导出目录" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtExportRoot" Grid.Column="1" Height="24" Margin="4,0" VerticalContentAlignment="Center"
                                     ToolTip="将创建 images、segmentation 子目录；默认填数据集下的 halcon_dl_export"/>
                            <Button Grid.Column="2" Content="浏览…" Width="72" Height="26" Margin="4,0,0,0" Click="BtnBrowseExport_Click"/>
                        </Grid>
                        <TextBlock Text="类别名（可选，写入 spec；留空则尝试读 data.yaml）" FontSize="11" Foreground="#666" Margin="0,6,0,2"/>
                        <TextBox x:Name="TxtClassNames" Height="24" VerticalContentAlignment="Center"
                                 ToolTip="英文逗号分隔，需与 YOLO 类别 id 顺序一致"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="BtnExportHalcon" Content="导出 HALCON 分割数据集" Width="200" Height="28" Margin="0,0,8,4" Click="BtnExportHalcon_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="训练（Halcon 20.11：HDlModel.TrainDlModelBatch）" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,0,0,8"
                                   Text="使用上方「导出目录」下的 images 与 segmentation；预训练 .hdl 类别数须与数据一致（如 MVTec 自带的 pretrained_dl_segmentation_compact.hdl）。需要 Deep Learning 训练授权；耗时较长时会阻塞界面线程以外的 HALCON 调用。"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="预训练 .hdl" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTrainPretrainedHdl" Grid.Column="1" Height="24" Margin="4,0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="浏览…" Width="72" Height="26" Margin="4,0,0,0" Click="BtnBrowseTrainPretrained_Click"/>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输出 .hdl" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTrainOutputHdl" Grid.Column="1" Height="24" Margin="4,0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="浏览…" Width="72" Height="26" Margin="4,0,0,0" Click="BtnBrowseTrainOutput_Click"/>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="epochs" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTrainEpochs" Grid.Column="1" Height="24" Margin="4,0,8,0" VerticalContentAlignment="Center" Text="5"/>
                            <TextBlock Grid.Column="2" Text="batch" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTrainBatch" Grid.Column="3" Height="24" Margin="4,0,8,0" VerticalContentAlignment="Center" Text="2"/>
                            <TextBlock Grid.Column="4" Text="lr" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTrainLr" Grid.Column="5" Height="24" Margin="4,0,0,0" VerticalContentAlignment="Center" Text="0.001"/>
                        </Grid>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="runtime" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbTrainRuntime" Grid.Column="1" Height="26" Margin="4,0,0,0" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="gpu" IsSelected="True"/>
                                <ComboBoxItem Content="cpu"/>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="ChkTrainImageReal01" Margin="0,2,0,4" VerticalContentAlignment="Center"
                                  ToolTip="默认关闭：训练 image 为 byte，与本页推理一致。若报 #9001 可尝试勾选以使用 real [0,1]。"
                                  Content="训练 image 使用 real [0,1]（默认关闭：byte，对齐推理）"/>
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="BtnStartTrain" Content="开始训练…" Width="120" Height="28" Margin="0,0,8,4" Click="BtnStartTrain_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtTrainHint" TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,8,0,0"
                                   Text="当前构建未引用 HalconDotNet 时，训练不可用。"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="推理（需 Deep Learning 授权与 .hdl）" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模型 .hdl" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtModelHdl" Grid.Column="1" Height="24" Margin="4,0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="浏览…" Width="72" Height="26" Margin="4,0,0,0" Click="BtnBrowseModel_Click"/>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="测试图像" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTestImage" Grid.Column="1" Height="24" Margin="4,0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="浏览…" Width="72" Height="26" Margin="4,0,0,0" Click="BtnBrowseTestImage_Click"/>
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="BtnRunInfer" Content="运行推理并保存掩膜…" Width="180" Height="28" Margin="0,0,8,4" Click="BtnRunInfer_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtHalconInferHint" TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,8,0,0"
                                   Text="当前构建未引用 HalconDotNet 时，推理按钮不可用。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="8,0,8,8">
            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Text="日志" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtLog" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="#1E1E1E" Foreground="#E0E0E0"/>
        </DockPanel>
    </Grid>
</Page>
