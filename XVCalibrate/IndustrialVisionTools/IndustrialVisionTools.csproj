<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>IndustrialVisionTools</AssemblyName>
    <RootNamespace>CalibOperatorCLI_Example</RootNamespace>
    <AssemblyTitle>工业视觉工具</AssemblyTitle>
    <Product>工业视觉工具</Product>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!-- HALCON：未安装时跳过引用与算子。
       MSBuild 会把「环境变量 HalconRoot」映射为同名属性；若误指向无 bin 的目录会挡住默认路径。
       HalconRootEffective：仅在候选路径下存在 bin 时采纳，否则依次尝试 D:\HALCON、HALCONROOT，最后仍回退原 HalconRoot/D:\HALCON。 -->
  <PropertyGroup>
    <HalconRootEffective Condition="'$(HalconRoot)' != '' and Exists('$(HalconRoot)\bin')">$(HalconRoot)</HalconRootEffective>
    <HalconRootEffective Condition="'$(HalconRootEffective)'=='' and Exists('D:\HALCON\bin')">D:\HALCON</HalconRootEffective>
    <HalconRootEffective Condition="'$(HalconRootEffective)'=='' and '$(HALCONROOT)' != '' and Exists('$(HALCONROOT)\bin')">$(HALCONROOT)</HalconRootEffective>
    <HalconRootEffective Condition="'$(HalconRootEffective)'=='' and '$(HalconRoot)' != ''">$(HalconRoot)</HalconRootEffective>
    <HalconRootEffective Condition="'$(HalconRootEffective)'==''">D:\HALCON</HalconRootEffective>
  </PropertyGroup>
  <PropertyGroup>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRootEffective)\bin\dotnet80\HalconDotNet.dll')">$(HalconRootEffective)\bin\dotnet80\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRootEffective)\bin\dotnet60\HalconDotNet.dll')">$(HalconRootEffective)\bin\dotnet60\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRootEffective)\bin\dotnet50\HalconDotNet.dll')">$(HalconRootEffective)\bin\dotnet50\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRootEffective)\bin\dotnet48\HalconDotNet.dll')">$(HalconRootEffective)\bin\dotnet48\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRootEffective)\bin\dotnet45\HalconDotNet.dll')">$(HalconRootEffective)\bin\dotnet45\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRootEffective)\bin\dotnet40\HalconDotNet.dll')">$(HalconRootEffective)\bin\dotnet40\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRootEffective)\bin\dotnet35\HalconDotNet.dll')">$(HalconRootEffective)\bin\dotnet35\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRootEffective)\bin\dotnet20\HalconDotNet.dll')">$(HalconRootEffective)\bin\dotnet20\HalconDotNet.dll</HalconDotNetDll>
    <HalconDotNetDll Condition="'$(HalconDotNetDll)'=='' and Exists('$(HalconRootEffective)\bin\dotnetcore31\HalconDotNet.dll')">$(HalconRootEffective)\bin\dotnetcore31\HalconDotNet.dll</HalconDotNetDll>
  </PropertyGroup>
  <!-- 本地 HALCON 安装优先；否则回退 NuGet（MVTec.HalconDotNet）以启用 HALCON_ENABLED -->
  <PropertyGroup Condition="'$(HalconDotNetDll)' != ''">
    <HalconEnabled>true</HalconEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(HalconDotNetDll)' == ''">
    <PackageReference Include="MVTec.HalconDotNet" Version="25110.0.0" />
  </ItemGroup>
  <PropertyGroup Condition="'$(HalconDotNetDll)' == ''">
    <HalconEnabled>true</HalconEnabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HalconEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);HALCON_ENABLED</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HalconDotNetDll)' != ''">
    <Reference Include="HalconDotNet">
      <HintPath>$(HalconDotNetDll)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HalconEnabled)' != 'true'">
    <Compile Remove="HalconFlowBridge.cs" />
    <Compile Remove="HalconDlSegBridge.cs" />
    <Compile Remove="HalconDlSegBridge.Preprocess.cs" />
    <Compile Remove="HalconDlSegBridge.Inference.cs" />
    <Compile Remove="HalconDlSegTrainOptions.cs" />
    <Compile Remove="HalconDlSegTrainDiagnostics.cs" />
    <Compile Remove="HalconDlSegTrainDataset.cs" />
    <Compile Remove="HalconDlSegTrainSampleBuilder.cs" />
    <Compile Remove="HalconDlSegTrainRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" Version="2.25.0" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="HslCommunication" Version="12.7.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.0" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\YoloSeg_Tools\auto_label_seg.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>YoloSeg_Tools\auto_label_seg.py</Link>
    </None>
    <None Include="..\..\YoloSeg_Tools\train_seg.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>YoloSeg_Tools\train_seg.py</Link>
    </None>
    <None Include="..\..\YoloSeg_Tools\predict_seg.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>YoloSeg_Tools\predict_seg.py</Link>
    </None>
    <None Include="..\..\YoloSeg_Tools\requirements-yolo-seg.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>YoloSeg_Tools\requirements-yolo-seg.txt</Link>
    </None>
    <None Include="..\..\SAM_Inference\export_sam_onnx.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SAM_Tools\export_sam_onnx.py</Link>
    </None>
    <None Include="..\..\SAM_Inference\quantize_sam_onnx.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SAM_Tools\quantize_sam_onnx.py</Link>
    </None>
    <None Include="..\..\SAM_Inference\requirements-onnx.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SAM_Tools\requirements-onnx.txt</Link>
    </None>
    <None Include="..\..\SAM_Inference\gen_masks_from_yolo_seg.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SAM_Tools\gen_masks_from_yolo_seg.py</Link>
    </None>
    <None Include="..\..\SAM_Inference\train_sam_finetune.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SAM_Tools\train_sam_finetune.py</Link>
    </None>
    <None Include="..\..\SAM_Inference\requirements-sam-train.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SAM_Tools\requirements-sam-train.txt</Link>
    </None>
  </ItemGroup>

  <!-- PLC 配置文件复制到输出目录 -->
  <ItemGroup>
    <None Include="plc_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 光源控制器 Controller_SDK-V4.0.0.1（与 demo 相同 C#_DLL\x64） -->
  <PropertyGroup>
    <ControllerSdkDir>$(MSBuildThisFileDirectory)..\..\Controller_SDK-V4.0.0.1(demo)\SDK\C#_DLL\x64</ControllerSdkDir>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(ControllerSdkDir)\ControllerDllCSharp.dll')">
    <DefineConstants>$(DefineConstants);CONTROLLER_SDK_ENABLED</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ControllerSdkDir)\ControllerDllCSharp.dll')">
    <Reference Include="ControllerDllCSharp">
      <HintPath>$(ControllerSdkDir)\ControllerDllCSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- 信捷 PLC（XinJETcpNet）依赖：强制复制到输出，避免 exe 被占用时 NuGet 拷贝被跳过导致运行期 FileNotFound -->
  <Target Name="CopyHslCommunicationToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_HslDll Condition="Exists('$(PkgHslCommunication)\lib\netstandard2.1\HslCommunication.dll')">$(PkgHslCommunication)\lib\netstandard2.1\HslCommunication.dll</_HslDll>
      <_HslDll Condition="'$(_HslDll)' == '' and Exists('$(PkgHslCommunication)\lib\netstandard2.0\HslCommunication.dll')">$(PkgHslCommunication)\lib\netstandard2.0\HslCommunication.dll</_HslDll>
    </PropertyGroup>
    <Error Condition="'$(_HslDll)' == ''" Text="未找到 HslCommunication.dll，请执行: dotnet restore $(MSBuildProjectFile)" />
    <Copy SourceFiles="$(_HslDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(PkgHslCommunication)\lib\netstandard2.1\HslCommunication.xml" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(PkgHslCommunication)\lib\netstandard2.1\HslCommunication.xml')" />
  </Target>

  <!-- 光源控制器原生 DLL 必须与 exe 同目录（ControllerDllCSharp 通过 DllImport 加载 CommonToolDll 等） -->
  <Target Name="CopyControllerSdkNative" AfterTargets="Build" Condition="Exists('$(ControllerSdkDir)\ControllerDllCSharp.dll')">
    <Copy SourceFiles="$(ControllerSdkDir)\CommonToolDll.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ControllerSdkDir)\ControllerDll.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ControllerSdkDir)\sControllerDll.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ControllerSdkDir)\ControllerDllCSharp.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
    <Message Text="[ControllerSDK] 已复制原生 DLL 到 $(OutputPath)" Importance="normal" />
  </Target>
  <Target Name="CopyControllerSdkNativeToPublish" BeforeTargets="CopyFilesToPublishDirectory" Condition="Exists('$(ControllerSdkDir)\ControllerDllCSharp.dll')">
    <Copy SourceFiles="$(ControllerSdkDir)\CommonToolDll.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ControllerSdkDir)\ControllerDll.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ControllerSdkDir)\sControllerDll.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ControllerSdkDir)\ControllerDllCSharp.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

  <!-- 海康威视相机 SDK（Private 确保 publish 带上托管 DLL；原生 MvCameraControl.dll 来自 MVS Runtime 复制） -->
  <ItemGroup>
    <Reference Include="MvCameraControl.Net">
      <HintPath>..\..\Development\DotNet\win64\netstandard2.0\MvCameraControl.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 复制依赖的 DLL 到输出目录 -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="..\..\bin\x64\Debug\IndustrialVisionToolsNative.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>IndustrialVisionToolsNative.dll</Link>
    </None>
    <None Include="..\..\bin\x64\Debug\IndustrialVisionToolsNative.pdb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>IndustrialVisionToolsNative.pdb</Link>
    </None>
    <None Include="..\..\opencv\build\x64\vc16\bin\opencv_world4130d.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="..\..\bin\x64\Release\IndustrialVisionToolsNative.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>IndustrialVisionToolsNative.dll</Link>
    </None>
    <None Include="..\..\opencv\build\x64\vc16\bin\opencv_world4130.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EnableUnmanagedDebugging>true</EnableUnmanagedDebugging>
  </PropertyGroup>

  <!-- HALCON x64 原生 DLL（与 exe 同目录，供 halconxl 等加载） -->
  <Target Name="CopyHalconNativeDlls" AfterTargets="Build" Condition="Exists('$(HalconRootEffective)\bin\x64-win64')">
    <ItemGroup>
      <_HalconNative Include="$(HalconRootEffective)\bin\x64-win64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_HalconNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish：在 SDK 拷贝到 PublishDir 之前写入，确保 Inno 与运行时一致 -->
  <Target Name="CopyHalconArtifactsToPublish" BeforeTargets="CopyFilesToPublishDirectory" Condition="Exists('$(HalconRootEffective)\bin\x64-win64')">
    <ItemGroup>
      <_HalconNativePub Include="$(HalconRootEffective)\bin\x64-win64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_HalconNativePub)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(HalconDotNetDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(HalconDotNetDll)' != '' and Exists('$(HalconDotNetDll)')" />
  </Target>

  <!-- 编译后自动复制海康 MVS Runtime（路径：先读 Windows 环境变量，再 MSBuild 属性；与资源管理器路径一致） -->
  <Target Name="CopyMvsRuntime" AfterTargets="Build" Condition="'$(PlatformTarget)' == 'x64'">
    <PropertyGroup>
      <_MvsCp86>$([System.Environment]::GetEnvironmentVariable('CommonProgramFiles(x86)'))</_MvsCp86>
      <_MvsPf86>$([System.Environment]::GetEnvironmentVariable('ProgramFiles(x86)'))</_MvsPf86>
      <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and '$(_MvsCp86)' != '' and Exists('$(_MvsCp86)\MVS\Runtime\Win64_x64')">$(_MvsCp86)\MVS\Runtime\Win64_x64</MvsRuntimeDir>
      <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and '$(_MvsPf86)' != '' and Exists('$(_MvsPf86)\Common Files\MVS\Runtime\Win64_x64')">$(_MvsPf86)\Common Files\MVS\Runtime\Win64_x64</MvsRuntimeDir>
      <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and Exists('$(CommonProgramFiles(x86))\MVS\Runtime\Win64_x64')">$(CommonProgramFiles(x86))\MVS\Runtime\Win64_x64</MvsRuntimeDir>
      <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and Exists('$(CommonProgramFiles)\MVS\Runtime\Win64_x64')">$(CommonProgramFiles)\MVS\Runtime\Win64_x64</MvsRuntimeDir>
      <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and Exists('$(ProgramFiles(x86))\Common Files\MVS\Runtime\Win64_x64')">$(ProgramFiles(x86))\Common Files\MVS\Runtime\Win64_x64</MvsRuntimeDir>
      <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and Exists('$(ProgramFiles)\Common Files\MVS\Runtime\Win64_x64')">$(ProgramFiles)\Common Files\MVS\Runtime\Win64_x64</MvsRuntimeDir>
      <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and Exists('D:\MVS\Runtime\Win64_x64')">D:\MVS\Runtime\Win64_x64</MvsRuntimeDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(MvsRuntimeDir)' != ''">
      <!-- 保留 Win64_x64 下子目录（GenICam 等）；勿扁平化为单一输出目录，否则同名 DLL 互相覆盖且 .cti/.xml 丢失 -->
      <_MvsRuntimeFile Include="$(MvsRuntimeDir)\**\*.*" Exclude="$(MvsRuntimeDir)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_MvsRuntimeFile)" DestinationFiles="@(_MvsRuntimeFile->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_MvsRuntimeFile)' != ''" />
  </Target>

  <!-- 海康 MVS：在 SDK 冲突消解之后、增量清理读取 ResolvedFileToPublish 之前写入清单，否则会被 ResolveOverlapping / 孤儿清理丢掉。 -->
  <Target Name="AddMvsRuntimeToResolvedFileToPublish" AfterTargets="ComputeResolvedFilesToPublishList" BeforeTargets="_GetCurrentAndPriorPublishFileWrites">
    <PropertyGroup>
      <_MvsCp86>$([System.Environment]::GetEnvironmentVariable('CommonProgramFiles(x86)'))</_MvsCp86>
      <_MvsPf86>$([System.Environment]::GetEnvironmentVariable('ProgramFiles(x86)'))</_MvsPf86>
      <_MvsRtPub Condition="'$(MvsRuntimeDir)' != '' and Exists('$(MvsRuntimeDir)')">$(MvsRuntimeDir)</_MvsRtPub>
      <_MvsRtPub Condition="'$(_MvsRtPub)' == '' and '$(_MvsCp86)' != '' and Exists('$(_MvsCp86)\MVS\Runtime\Win64_x64')">$(_MvsCp86)\MVS\Runtime\Win64_x64</_MvsRtPub>
      <_MvsRtPub Condition="'$(_MvsRtPub)' == '' and '$(_MvsPf86)' != '' and Exists('$(_MvsPf86)\Common Files\MVS\Runtime\Win64_x64')">$(_MvsPf86)\Common Files\MVS\Runtime\Win64_x64</_MvsRtPub>
      <_MvsRtPub Condition="'$(_MvsRtPub)' == '' and Exists('$(CommonProgramFiles(x86))\MVS\Runtime\Win64_x64')">$(CommonProgramFiles(x86))\MVS\Runtime\Win64_x64</_MvsRtPub>
      <_MvsRtPub Condition="'$(_MvsRtPub)' == '' and Exists('$(CommonProgramFiles)\MVS\Runtime\Win64_x64')">$(CommonProgramFiles)\MVS\Runtime\Win64_x64</_MvsRtPub>
      <_MvsRtPub Condition="'$(_MvsRtPub)' == '' and Exists('$(ProgramFiles(x86))\Common Files\MVS\Runtime\Win64_x64')">$(ProgramFiles(x86))\Common Files\MVS\Runtime\Win64_x64</_MvsRtPub>
      <_MvsRtPub Condition="'$(_MvsRtPub)' == '' and Exists('$(ProgramFiles)\Common Files\MVS\Runtime\Win64_x64')">$(ProgramFiles)\Common Files\MVS\Runtime\Win64_x64</_MvsRtPub>
      <_MvsRtPub Condition="'$(_MvsRtPub)' == '' and Exists('D:\MVS\Runtime\Win64_x64')">D:\MVS\Runtime\Win64_x64</_MvsRtPub>
    </PropertyGroup>
    <Warning Text="未找到海康 MVS Win64_x64 运行时目录，publish 将不包含相机运行时文件；请安装 MVS 或设置 MvsRuntimeDir，或设置 SuppressMvsPublishMissingWarning=true。" Condition="'$(_IsPublishing)' == 'true' and '$(_MvsRtPub)' == '' and '$(SuppressMvsPublishMissingWarning)' != 'true'" />
    <ItemGroup Condition="'$(_MvsRtPub)' != ''">
      <_MvsForPub Include="$(_MvsRtPub)\**\*.*" Exclude="$(_MvsRtPub)\**\*.pdb" />
    </ItemGroup>
    <ItemGroup Condition="'@(_MvsForPub)' != ''">
      <ResolvedFileToPublish Include="@(_MvsForPub)" ExcludeFromSingleFile="true">
        <RelativePath>%(_MvsForPub.RecursiveDir)%(_MvsForPub.Filename)%(_MvsForPub.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Message Text="[MVS] publish 已加入 ResolvedFileToPublish: $(_MvsRtPub) -&gt; $(PublishDir)" Condition="'$(_MvsRtPub)' != '' and '@(_MvsForPub)' != ''" Importance="normal" />
  </Target>
</Project>