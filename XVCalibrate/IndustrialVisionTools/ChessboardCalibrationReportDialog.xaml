<Window x:Class="CalibOperatorCLI_Example.ChessboardCalibrationReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="棋盘格标定质检"
        Width="720"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#252526"
        Foreground="#E0E0E0"
        ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" IsDefault="True" MinWidth="88" Height="30" Padding="12,4" Click="Ok_Click"/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Background="#2D2D30" BorderBrush="#3C3C3C" BorderThickness="1"
                Padding="10,8" Margin="0,0,0,10" CornerRadius="4">
            <TextBlock x:Name="TxtHeadline" Text="" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBox x:Name="TxtReport"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#E0E0E0"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     FontSize="13"
                     Padding="4"/>
        </ScrollViewer>
    </DockPanel>
</Window>
