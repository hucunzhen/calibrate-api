                                <DataGridTextColumn Header="点1.Z" Binding="{Binding p1z, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="圆心X" Binding="{Binding cx, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="圆心Y" Binding="{Binding cy, StringFormat=F3}" Width="65"/>
