                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource Ui.InputBackground}" BorderBrush="{StaticResource Ui.PanelBorder}"
                            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="12,8">
                        <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" Foreground="{StaticResource Ui.TextSecondary}" FontFamily="Consolas"/>
                    </Border>
                    <TextBox x:Name="LogTextBox" Grid.Row="1" Height="120" MinHeight="80" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                             Background="#1E1E1E" Foreground="#A5D6A7" BorderThickness="0"
                             AcceptsReturn="True" TextWrapping="Wrap" Padding="10,8"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
