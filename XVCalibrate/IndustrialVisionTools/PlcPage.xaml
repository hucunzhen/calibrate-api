<Page x:Class="CalibOperatorCLI_Example.PlcPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PLC 通讯"
      Background="{StaticResource Ui.PageBackground}">
    <Page.Resources>
        <Style x:Key="PlcSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PlcSubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PlcCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ui.CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="PlcMetricCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PlcAccentBar" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="PlcTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 连接 -->
            <Border Grid.Row="0" Style="{StaticResource PlcCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="4" CornerRadius="2" Background="#1565C0" Margin="0,2,14,2"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource PlcSectionTitle}" Text="PLC 连接" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IP" VerticalAlignment="Center" Foreground="#78909C" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtPlcIp" Text="192.168.6.6" Width="130" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="端口" VerticalAlignment="Center" Foreground="#78909C" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtPlcPort" Text="502" Width="60" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                            <Button x:Name="BtnPlcConnect" Content="连接" Width="80" Height="30" Margin="0,0,8,0" Click="BtnPlcConnect_Click"/>
                            <Button x:Name="BtnPlcDisconnect" Content="断开" Width="80" Height="30" IsEnabled="False" Click="BtnPlcDisconnect_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#ECEFF1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPlcStatus" Text="[未连接]" Foreground="#546E7A" FontWeight="SemiBold" FontFamily="Consolas" FontSize="13"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 实时位置 -->
            <Border Grid.Row="1" Style="{StaticResource PlcCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PlcSectionTitle}" Text="实时位置" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkAutoRead" Content="自动刷新" VerticalAlignment="Center" Margin="0,0,8,0" IsChecked="False"
                                      Checked="ChkAutoRead_Checked" Unchecked="ChkAutoRead_Unchecked"
                                      ToolTip="定时读取 XYZ，并读 D800+GVAR 刷新 3D"/>
                            <TextBlock Text="间隔 ms" VerticalAlignment="Center" Foreground="#78909C" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtReadInterval" Text="500" Width="52" Height="26" VerticalContentAlignment="Center" TextChanged="TxtReadInterval_TextChanged"/>
                            <Button x:Name="BtnReadOnce" Content="读取" Width="56" Height="28" Margin="10,0,0,0" Click="BtnReadOnce_Click"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,0">
                        <Border Style="{StaticResource PlcMetricCard}" Background="#FFF5F5" BorderBrush="#FFCDD2" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="X" FontSize="12" FontWeight="SemiBold" Foreground="#C62828" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPosX" Text="---" FontSize="26" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PlcMetricCard}" Background="#F3F8FF" BorderBrush="#BBDEFB" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Y" FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPosY" Text="---" FontSize="26" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PlcMetricCard}" Background="#F1F8E9" BorderBrush="#C5E1A5" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Z" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPosZ" Text="---" FontSize="26" FontWeight="Bold" Foreground="#388E3C" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PlcMetricCard}" Background="#FFF8E1" BorderBrush="#FFE082" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="XY 速度" FontSize="12" FontWeight="SemiBold" Foreground="#F57F17" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtSpeedXY" Text="---" FontSize="26" FontWeight="Bold" Foreground="#F57F17" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 控制区 Tab -->
            <Border Grid.Row="2" Style="{StaticResource PlcCard}" Padding="0">
                <TabControl BorderThickness="0" Background="Transparent" Margin="8,4,8,8">
                    <TabItem Header="手动与运行" Style="{StaticResource PlcTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" Padding="8,10,8,4">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <Button x:Name="BtnManual" Content="手动模式" Width="110" Height="32" Margin="0,0,8,8" Click="BtnManual_Click" Foreground="#6A1B9A" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnAuto" Content="关闭手动模式" Width="130" Height="32" Margin="0,0,8,8" Click="BtnAuto_Click" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtModeStatus" Text="---" VerticalAlignment="Center" Margin="4,0,16,8" Foreground="#546E7A" FontFamily="Consolas" FontWeight="Bold"/>
                                    <Button x:Name="BtnCalibrationMode" Content="标定模式" Width="110" Height="32" Margin="0,0,8,8" Click="BtnCalibrationMode_Click" Foreground="#4527A0" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtCalibrationModeStatus" Text="---" VerticalAlignment="Center" Margin="4,0,16,8" Foreground="#546E7A" FontFamily="Consolas" FontWeight="Bold"/>
                                    <Button x:Name="BtnStart" Content="启动" Width="100" Height="32" Margin="0,0,8,8" Click="BtnStart_Click" Foreground="#E65100" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnStop" Content="停止" Width="100" Height="32" Margin="0,0,8,8" Click="BtnStop_Click" Foreground="#455A64" FontWeight="SemiBold"/>
                                    <TextBlock Text="运行" VerticalAlignment="Center" Foreground="#78909C" Margin="0,0,4,8"/>
                                    <TextBlock x:Name="TxtRunStatus" Text="---" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#546E7A" FontFamily="Consolas" FontWeight="Bold"/>
                                </WrapPanel>

                                <!-- X 轴点动 -->
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PlcAccentBar}" Background="#D32F2F"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="X 轴" FontWeight="SemiBold" Foreground="#D32F2F" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnXForward" Content="正转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <Button x:Name="BtnXReverse" Content="反转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <TextBlock x:Name="TxtXRotateStatus" Text="---" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="#90A4AE" FontFamily="Consolas"/>
                                                <Button x:Name="BtnXZero" Content="回零" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="LblXEnable" Text="使能" VerticalAlignment="Center" Foreground="#D32F2F" Margin="8,0,4,0"/>
                                                <Button x:Name="BtnXEnable" Content="开" Width="52" Height="26" Margin="0,0,4,0" Click="BtnXEnable_Click"/>
                                                <Button x:Name="BtnXDisable" Content="关" Width="52" Height="26" Margin="0,0,4,0" Click="BtnXDisable_Click" Foreground="#455A64"/>
                                                <TextBlock x:Name="TxtXEnableStatus" Text="关" VerticalAlignment="Center" Margin="4,0,12,0" FontFamily="Consolas" Foreground="#78909C"/>
                                                <TextBlock x:Name="LblXAlarm" Text="报警" VerticalAlignment="Center" Foreground="#D32F2F" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnXAlarmClear" Content="清除" Width="52" Height="26" Click="BtnXAlarmClear_Click" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Y 轴点动 -->
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PlcAccentBar}" Background="#1976D2"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Y 轴" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnYForward" Content="正转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <Button x:Name="BtnYReverse" Content="反转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <TextBlock x:Name="TxtYRotateStatus" Text="---" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="#90A4AE" FontFamily="Consolas"/>
                                                <Button x:Name="BtnYZero" Content="回零" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="LblYEnable" Text="使能" VerticalAlignment="Center" Foreground="#1976D2" Margin="8,0,4,0"/>
                                                <Button x:Name="BtnYEnable" Content="开" Width="52" Height="26" Margin="0,0,4,0" Click="BtnYEnable_Click"/>
                                                <Button x:Name="BtnYDisable" Content="关" Width="52" Height="26" Margin="0,0,4,0" Click="BtnYDisable_Click" Foreground="#455A64"/>
                                                <TextBlock x:Name="TxtYEnableStatus" Text="关" VerticalAlignment="Center" Margin="4,0,12,0" FontFamily="Consolas" Foreground="#78909C"/>
                                                <TextBlock x:Name="LblYAlarm" Text="报警" VerticalAlignment="Center" Foreground="#1976D2" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnYAlarmClear" Content="清除" Width="52" Height="26" Click="BtnYAlarmClear_Click" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Z 轴点动 -->
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PlcAccentBar}" Background="#388E3C"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Z 轴" FontWeight="SemiBold" Foreground="#388E3C" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnZForward" Content="正转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <Button x:Name="BtnZReverse" Content="反转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <TextBlock x:Name="TxtZRotateStatus" Text="---" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="#90A4AE" FontFamily="Consolas"/>
                                                <Button x:Name="BtnZZero" Content="回零" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="LblZEnable" Text="使能" VerticalAlignment="Center" Foreground="#388E3C" Margin="8,0,4,0"/>
                                                <Button x:Name="BtnZEnable" Content="开" Width="52" Height="26" Margin="0,0,4,0" Click="BtnZEnable_Click"/>
                                                <Button x:Name="BtnZDisable" Content="关" Width="52" Height="26" Margin="0,0,4,0" Click="BtnZDisable_Click" Foreground="#455A64"/>
                                                <TextBlock x:Name="TxtZEnableStatus" Text="关" VerticalAlignment="Center" Margin="4,0,12,0" FontFamily="Consolas" Foreground="#78909C"/>
                                                <TextBlock x:Name="LblZAlarm" Text="报警" VerticalAlignment="Center" Foreground="#388E3C" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnZAlarmClear" Content="清除" Width="52" Height="26" Click="BtnZAlarmClear_Click" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="工艺与 IO" Style="{StaticResource PlcTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" Padding="8,10,8,4">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PlcSubTitle}" Text="激光与辅助"/>
                                <WrapPanel Margin="0,0,0,14">
                                    <TextBlock x:Name="LblLaserPower" Text="功率" VerticalAlignment="Center" Foreground="#E65100" Margin="0,0,4,8"/>
                                    <TextBox x:Name="TxtLaserPower" Width="72" Height="26" VerticalContentAlignment="Center" Margin="0,0,4,8"/>
                                    <Button x:Name="BtnReadLaserPower" Content="读" Width="36" Height="26" Margin="0,0,4,8" Click="BtnReadLaserPower_Click"/>
                                    <Button x:Name="BtnWriteLaserPower" Content="写" Width="36" Height="26" Margin="0,0,12,8" Click="BtnWriteLaserPower_Click" Foreground="#E65100" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnLaserToggle" Content="激光" Width="56" Height="26" Margin="0,0,4,8" Click="BtnLaserToggle_Click" Foreground="#E65100" FontWeight="SemiBold"
                                            ToolTip="点击切换激光使能开/关"/>
                                    <TextBlock x:Name="TxtLaserEnableStatus" Text="关" VerticalAlignment="Center" Margin="0,0,12,8" FontFamily="Consolas"/>
                                    <TextBlock Text="红光" VerticalAlignment="Center" Foreground="#C62828" Margin="0,0,4,8"/>
                                    <Button x:Name="BtnRedLightEnable" Content="开" Width="44" Height="26" Margin="0,0,4,8" Click="BtnRedLightEnable_Click" Foreground="#C62828"/>
                                    <Button x:Name="BtnRedLightDisable" Content="关" Width="44" Height="26" Margin="0,0,4,8" Click="BtnRedLightDisable_Click"/>
                                    <TextBlock x:Name="TxtRedLightEnableStatus" Text="关" VerticalAlignment="Center" Margin="0,0,12,8" FontFamily="Consolas"/>
                                    <Button x:Name="BtnBlowToggle" Content="吹气" Width="56" Height="26" Margin="0,0,4,8" Click="BtnBlowToggle_Click" Foreground="#0277BD" FontWeight="SemiBold"
                                            ToolTip="点击切换吹气使能开/关"/>
                                    <TextBlock x:Name="TxtBlowEnableStatus" Text="关" VerticalAlignment="Center" Margin="0,0,12,8" FontFamily="Consolas"/>
                                    <Button x:Name="BtnCameraCaptureStart" Content="相机拍照" Width="88" Height="28" Margin="0,0,0,8" Click="BtnCameraCaptureStart_Click" Foreground="#5E35B1" FontWeight="SemiBold"/>
                                </WrapPanel>

                                <TextBlock Style="{StaticResource PlcSubTitle}" Text="焊接完成标志"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F3E5F5" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="PLC → 上位机" FontWeight="SemiBold" Foreground="#6A1B9A" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="状态" Foreground="#78909C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="TxtWeldDoneStatus" Text="---" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnReadWeldDone" Content="读" Width="36" Height="24" Margin="0,0,4,0" Click="BtnReadWeldDone_Click"/>
                                                <Button x:Name="BtnClearWeldDone" Content="清零" Width="44" Height="24" Click="BtnClearWeldDone_Click" Foreground="#6A1B9A" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#EDE7F6" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="上位机 → PLC" FontWeight="SemiBold" Foreground="#4527A0" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnSetWeldDoneHost" Content="置1" Width="40" Height="24" Margin="0,0,4,0" Click="BtnSetWeldDoneHost_Click" Foreground="#4527A0" FontWeight="SemiBold"/>
                                                <Button x:Name="BtnClearWeldDoneHost" Content="清零" Width="44" Height="24" Margin="0,0,8,0" Click="BtnClearWeldDoneHost_Click"/>
                                                <TextBlock Text="状态" Foreground="#78909C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="TxtWeldDoneHostStatus" Text="---" FontFamily="Consolas" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Style="{StaticResource PlcSubTitle}" Text="位置与速度"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnManualStopSafePos" Content="手动→安全位" Width="108" Height="28" Margin="0,0,8,8" Click="BtnManualStopSafePos_Click" Foreground="#455A64" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnManualPhotoPos" Content="手动→拍照位" Width="108" Height="28" Margin="0,0,8,8" Click="BtnManualPhotoPos_Click" Foreground="#5E35B1" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnManualLaserWeldPos" Content="手动→激光焊接位" Width="120" Height="28" Margin="0,0,16,8" Click="BtnManualLaserWeldPos_Click" Foreground="#E65100" FontWeight="SemiBold"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="停机安全" FontWeight="SemiBold" Foreground="#455A64" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBlock x:Name="LblStopSafeX" Text="X" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtStopSafeX" Width="68" Height="24" Margin="0,0,6,8"/>
                                    <TextBlock x:Name="LblStopSafeY" Text="Y" Foreground="#1976D2" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtStopSafeY" Width="68" Height="24" Margin="0,0,6,8"/>
                                    <TextBlock x:Name="LblStopSafeZ" Text="Z" Foreground="#388E3C" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtStopSafeZ" Width="68" Height="24" Margin="0,0,6,8"/>
                                    <Button x:Name="BtnReadStopSafePos" Content="读" Width="36" Height="24" Margin="0,0,4,8" Click="BtnReadStopSafePos_Click"/>
                                    <Button x:Name="BtnWriteStopSafePos" Content="写" Width="36" Height="24" Margin="0,0,16,8" Click="BtnWriteStopSafePos_Click" Foreground="#455A64" FontWeight="SemiBold"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="拍照位" FontWeight="SemiBold" Foreground="#5E35B1" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBlock x:Name="LblPhotoPosX" Text="X" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtPhotoPosX" Width="68" Height="24" Margin="0,0,6,8"/>
                                    <TextBlock x:Name="LblPhotoPosY" Text="Y" Foreground="#1976D2" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtPhotoPosY" Width="68" Height="24" Margin="0,0,6,8"/>
                                    <TextBlock x:Name="LblPhotoPosZ" Text="Z" Foreground="#388E3C" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtPhotoPosZ" Width="68" Height="24" Margin="0,0,6,8"/>
                                    <Button x:Name="BtnReadPhotoPos" Content="读" Width="36" Height="24" Margin="0,0,4,8" Click="BtnReadPhotoPos_Click"/>
                                    <Button x:Name="BtnWritePhotoPos" Content="写" Width="36" Height="24" Margin="0,0,16,8" Click="BtnWritePhotoPos_Click" Foreground="#5E35B1" FontWeight="SemiBold"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="激光焊接位" FontWeight="SemiBold" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBlock x:Name="LblLaserRelX" Text="X" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtLaserRelX" Width="68" Height="24" Margin="0,0,6,8"/>
                                    <TextBlock x:Name="LblLaserRelY" Text="Y" Foreground="#1976D2" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtLaserRelY" Width="68" Height="24" Margin="0,0,6,8"/>
                                    <TextBlock x:Name="LblLaserRelZ" Text="Z" Foreground="#388E3C" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtLaserRelZ" Width="68" Height="24" Margin="0,0,6,8"/>
                                    <Button x:Name="BtnReadLaserRelPos" Content="读" Width="36" Height="24" Margin="0,0,4,8" Click="BtnReadLaserRelPos_Click"/>
                                    <Button x:Name="BtnWriteLaserRelPos" Content="写" Width="36" Height="24" Margin="0,0,0,8" Click="BtnWriteLaserRelPos_Click" Foreground="#E65100" FontWeight="SemiBold"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock Text="运动速度" FontWeight="SemiBold" Foreground="#F57F17" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBlock x:Name="LblWeldSpeed" Text="焊" Foreground="#666" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtWeldSpeed" Width="56" Height="24" Margin="0,0,6,8"/>
                                    <TextBlock x:Name="LblReturnSafeSpeed" Text="返安全" Foreground="#666" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtReturnSafeSpeed" Width="56" Height="24" Margin="0,0,6,8"/>
                                    <TextBlock x:Name="LblPhotoApproachSpeed" Text="拍照" Foreground="#666" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtPhotoApproachSpeed" Width="56" Height="24" Margin="0,0,6,8"/>
                                    <TextBlock x:Name="LblFastOffsetSpeed" Text="快偏" Foreground="#666" VerticalAlignment="Center" Margin="0,0,2,8"/>
                                    <TextBox x:Name="TxtFastOffsetSpeed" Width="56" Height="24" Margin="0,0,6,8"/>
                                    <Button x:Name="BtnReadMotionSpeed" Content="读" Width="36" Height="24" Margin="0,0,4,8" Click="BtnReadMotionSpeed_Click"/>
                                    <Button x:Name="BtnWriteMotionSpeed" Content="写" Width="36" Height="24" Margin="0,0,0,8" Click="BtnWriteMotionSpeed_Click" Foreground="#F57F17" FontWeight="SemiBold"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="轴参数" Style="{StaticResource PlcTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" Padding="8,10,8,4">
                            <UniformGrid Columns="1">
                                <!-- X 参数 -->
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="X 轴参数" FontWeight="SemiBold" Foreground="#D32F2F" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <TextBlock x:Name="LblXHomeSpd" Text="复位" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtXHomeSpd" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadXHomeSpd" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadXHomeSpd_Click"/>
                                            <Button x:Name="BtnWriteXHomeSpd" Content="写" Width="26" Height="24" Margin="0,0,12,6" Click="BtnWriteXHomeSpd_Click" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LblXManualSpd" Text="手动" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtXManualSpd" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadXManualSpd" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadXManualSpd_Click"/>
                                            <Button x:Name="BtnWriteXManualSpd" Content="写" Width="26" Height="24" Margin="0,0,12,6" Click="BtnWriteXManualSpd_Click" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LblXPosLimit" Text="+限" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtXPosLimit" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadXPosLimit" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadXPosLimit_Click"/>
                                            <Button x:Name="BtnWriteXPosLimit" Content="写" Width="26" Height="24" Margin="0,0,12,6" Click="BtnWriteXPosLimit_Click" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LblXNegLimit" Text="-限" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtXNegLimit" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadXNegLimit" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadXNegLimit_Click"/>
                                            <Button x:Name="BtnWriteXNegLimit" Content="写" Width="26" Height="24" Margin="0,0,0,6" Click="BtnWriteXNegLimit_Click" Foreground="#1565C0"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Y 参数 -->
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Y 轴参数" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <TextBlock x:Name="LblYHomeSpd" Text="复位" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtYHomeSpd" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadYHomeSpd" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadYHomeSpd_Click"/>
                                            <Button x:Name="BtnWriteYHomeSpd" Content="写" Width="26" Height="24" Margin="0,0,12,6" Click="BtnWriteYHomeSpd_Click" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LblYManualSpd" Text="手动" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtYManualSpd" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadYManualSpd" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadYManualSpd_Click"/>
                                            <Button x:Name="BtnWriteYManualSpd" Content="写" Width="26" Height="24" Margin="0,0,12,6" Click="BtnWriteYManualSpd_Click" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LblYPosLimit" Text="+限" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtYPosLimit" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadYPosLimit" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadYPosLimit_Click"/>
                                            <Button x:Name="BtnWriteYPosLimit" Content="写" Width="26" Height="24" Margin="0,0,12,6" Click="BtnWriteYPosLimit_Click" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LblYNegLimit" Text="-限" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtYNegLimit" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadYNegLimit" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadYNegLimit_Click"/>
                                            <Button x:Name="BtnWriteYNegLimit" Content="写" Width="26" Height="24" Margin="0,0,0,6" Click="BtnWriteYNegLimit_Click" Foreground="#1565C0"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Z 参数 -->
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Z 轴参数" FontWeight="SemiBold" Foreground="#388E3C" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <TextBlock x:Name="LblZHomeSpd" Text="复位" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtZHomeSpd" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadZHomeSpd" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadZHomeSpd_Click"/>
                                            <Button x:Name="BtnWriteZHomeSpd" Content="写" Width="26" Height="24" Margin="0,0,12,6" Click="BtnWriteZHomeSpd_Click" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LblZManualSpd" Text="手动" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtZManualSpd" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadZManualSpd" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadZManualSpd_Click"/>
                                            <Button x:Name="BtnWriteZManualSpd" Content="写" Width="26" Height="24" Margin="0,0,12,6" Click="BtnWriteZManualSpd_Click" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LblZPosLimit" Text="+限" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtZPosLimit" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadZPosLimit" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadZPosLimit_Click"/>
                                            <Button x:Name="BtnWriteZPosLimit" Content="写" Width="26" Height="24" Margin="0,0,12,6" Click="BtnWriteZPosLimit_Click" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LblZNegLimit" Text="-限" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                            <TextBox x:Name="TxtZNegLimit" Width="64" Height="24" Margin="0,0,2,6"/>
                                            <Button x:Name="BtnReadZNegLimit" Content="读" Width="26" Height="24" Margin="0,0,2,6" Click="BtnReadZNegLimit_Click"/>
                                            <Button x:Name="BtnWriteZNegLimit" Content="写" Width="26" Height="24" Margin="0,0,0,6" Click="BtnWriteZNegLimit_Click" Foreground="#1565C0"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- GVAR -->
            <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#7B1FA2" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="4" Height="20" CornerRadius="2" Background="#7B1FA2" Margin="0,0,10,0"/>
                            <TextBlock Text="GVAR 轨迹" FontSize="15" FontWeight="SemiBold" Foreground="#7B1FA2"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="段数" Foreground="#78909C" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtGvarCount" Text="---" Width="48" Height="26" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="来自 plc_config 线段数寄存器（D800）"/>
                            <Button x:Name="BtnReadGvar" Content="读取" Width="52" Height="28" Margin="0,0,4,0" Click="BtnReadGvar_Click"/>
                            <Button x:Name="BtnWriteGvar" Content="写入全部" Width="72" Height="28" Margin="0,0,4,0" Click="BtnWriteGvar_Click" Foreground="#1565C0" FontWeight="SemiBold"/>
                            <Button x:Name="BtnClearGvar" Content="清空" Width="48" Height="28" Margin="0,0,4,0" Click="BtnClearGvar_Click" Foreground="#D32F2F"/>
                            <Button x:Name="BtnAddGvar" Content="+" Width="28" Height="28" Margin="0,0,4,0" Click="BtnAddGvar_Click" FontWeight="Bold"/>
                            <Button x:Name="BtnRemoveGvar" Content="−" Width="28" Height="28" Click="BtnRemoveGvar_Click" FontWeight="Bold" Foreground="#D32F2F"/>
                        </WrapPanel>
                    </Grid>
                    <Grid MinHeight="300">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*" MinWidth="280"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="DgGvarList" Grid.Column="0" MinHeight="280" Height="340" MaxHeight="480" Margin="0,0,10,0"
                                  VerticalScrollBarVisibility="Auto" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" FontFamily="Consolas" FontSize="11" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F5F5F5" RowBackground="White" BorderBrush="#E0E0E0" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="35" IsReadOnly="True"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding type1}" Width="50"/>
                                <DataGridTextColumn Header="点0.X" Binding="{Binding p0x, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="点0.Y" Binding="{Binding p0y, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="点0.Z" Binding="{Binding p0z, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="点1.X" Binding="{Binding p1x, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="点1.Y" Binding="{Binding p1y, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="点1.Z" Binding="{Binding p1z, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="圆心X" Binding="{Binding cx, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="圆心Y" Binding="{Binding cy, StringFormat=F3}" Width="65"/>
                                <DataGridTextColumn Header="半径" Binding="{Binding r, StringFormat=F3}" Width="55"/>
                                <DataGridTextColumn Header="起始角°" Binding="{Binding start_deg, StringFormat=F3}" Width="58"/>
                                <DataGridTextColumn Header="结束角°" Binding="{Binding end_deg, StringFormat=F3}" Width="58"/>
                                <DataGridTextColumn Header="高度0" Binding="{Binding z0, StringFormat=F3}" Width="55"/>
                                <DataGridTextColumn Header="高度1" Binding="{Binding z1, StringFormat=F3}" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" BorderBrush="#5E35B1" BorderThickness="1" CornerRadius="6" Background="#1C1C20">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="3D 预览" FontWeight="SemiBold" Foreground="#CE93D8" Margin="10,8,10,4"/>
                                <TextBlock DockPanel.Dock="Top" Text="网格+RGB=世界坐标 · 紫蓝=GVAR · 橙球=当前XYZ" Foreground="#666" FontSize="10" Margin="10,0,10,8"/>
                                <ContentControl x:Name="Gvar3DHost" MinHeight="280" Margin="6"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 状态 + 日志 -->
            <Border Grid.Row="4" Style="{StaticResource PlcCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#ECEFF1" CornerRadius="8,8,0,0" Padding="12,8">
                        <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" Foreground="#37474F" FontFamily="Consolas"/>
                    </Border>
                    <TextBox x:Name="LogTextBox" Grid.Row="1" Height="120" MinHeight="80" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                             Background="#1E1E1E" Foreground="#A5D6A7" BorderThickness="0"
                             AcceptsReturn="True" TextWrapping="Wrap" Padding="10,8"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
