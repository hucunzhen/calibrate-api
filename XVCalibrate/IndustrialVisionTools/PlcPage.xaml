<Page x:Class="CalibOperatorCLI_Example.PlcPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PLC 通讯"
      Background="{StaticResource Ui.WorkspaceBackground}">
    <Page.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Ui.DarkLabel}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource Ui.DarkTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Ui.DarkComboBox}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource Ui.DarkCheckBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource IndustrialToolbarButton}"/>

        <Style x:Key="PlcSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.SectionTitle}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PlcSubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PlcCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ui.CardDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="PlcMetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ui.InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.PanelBorder}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PlcInnerPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ui.InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="PlcAccentBar" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="PlcTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource NavBarBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" Margin="0,0,4,0" CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.PanelBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ui.SectionTitle}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlcDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Ui.InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextPrimary}"/>
            <Setter Property="RowBackground" Value="{StaticResource Ui.InputBackground}"/>
            <Setter Property="AlternatingRowBackground" Value="#252830"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ui.PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Ui.PanelBorder}"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 连接 -->
            <Border Grid.Row="0" Style="{StaticResource PlcCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="4" CornerRadius="2" Background="#1565C0" Margin="0,2,14,2"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource PlcSectionTitle}" Text="PLC 连接" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IP" VerticalAlignment="Center" Foreground="{StaticResource Ui.TextSecondary}" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtPlcIp" Text="192.168.6.6" Width="130" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="端口" VerticalAlignment="Center" Foreground="{StaticResource Ui.TextSecondary}" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtPlcPort" Text="502" Width="60" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                            <Button x:Name="BtnPlcConnect" Content="连接" Width="80" Height="30" Margin="0,0,8,0" Click="BtnPlcConnect_Click"/>
                            <Button x:Name="BtnPlcDisconnect" Content="断开" Width="80" Height="30" IsEnabled="False" Click="BtnPlcDisconnect_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource Ui.InputBackground}" BorderBrush="{StaticResource Ui.PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPlcStatus" Text="[未连接]" Foreground="{StaticResource Ui.TextSecondary}" FontWeight="SemiBold" FontFamily="Consolas" FontSize="13"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 实时位置 -->
            <Border Grid.Row="1" Style="{StaticResource PlcCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PlcSectionTitle}" Text="实时位置" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkAutoRead" Content="自动刷新" VerticalAlignment="Center" Margin="0,0,8,0" IsChecked="False"
                                      Checked="ChkAutoRead_Checked" Unchecked="ChkAutoRead_Unchecked"
                                      ToolTip="定时读取 XYZ、可读状态（模式/运行/使能/点动/焊接标志等），并读 D800+GVAR 刷新 3D"/>
                            <TextBlock Text="间隔 ms" VerticalAlignment="Center" Foreground="{StaticResource Ui.TextSecondary}" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtReadInterval" Text="500" Width="52" Height="26" VerticalContentAlignment="Center" TextChanged="TxtReadInterval_TextChanged"/>
                            <Button x:Name="BtnReadOnce" Content="读取" Width="56" Height="28" Margin="10,0,0,0" Click="BtnReadOnce_Click"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,0">
                        <Border Style="{StaticResource PlcMetricCard}" BorderBrush="#C62828" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="X" FontSize="12" FontWeight="SemiBold" Foreground="#C62828" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPosX" Text="---" FontSize="26" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PlcMetricCard}" BorderBrush="#1976D2" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Y" FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPosY" Text="---" FontSize="26" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PlcMetricCard}" BorderBrush="#388E3C" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Z" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPosZ" Text="---" FontSize="26" FontWeight="Bold" Foreground="#388E3C" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PlcMetricCard}" BorderBrush="#F57F17" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="XY 速度" FontSize="12" FontWeight="SemiBold" Foreground="#F57F17" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtSpeedXY" Text="---" FontSize="26" FontWeight="Bold" Foreground="#F57F17" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 控制区 Tab -->
            <Border Grid.Row="2" Style="{StaticResource PlcCard}" Padding="0">
                <TabControl BorderThickness="0" Background="{StaticResource Ui.PanelBackground}" Margin="8,4,8,8">
                    <TabItem x:Name="TabPlcManualRun" Header="手动与运行" Style="{StaticResource PlcTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" Padding="8,10,8,4">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <Button x:Name="BtnManual" Content="手动模式" Width="110" Height="32" Margin="0,0,8,8" Click="BtnManual_Click" Foreground="#6A1B9A" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnAuto" Content="关闭手动模式" Width="130" Height="32" Margin="0,0,8,8" Click="BtnAuto_Click" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtModeStatus" Text="---" VerticalAlignment="Center" Margin="4,0,16,8" Foreground="{StaticResource Ui.TextMuted}" FontFamily="Consolas" FontWeight="Bold"/>
                                    <Button x:Name="BtnCalibrationMode" Content="标定模式" Width="110" Height="32" Margin="0,0,8,8" Click="BtnCalibrationMode_Click" Foreground="#4527A0" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtCalibrationModeStatus" Text="---" VerticalAlignment="Center" Margin="4,0,16,8" Foreground="{StaticResource Ui.TextMuted}" FontFamily="Consolas" FontWeight="Bold"/>
                                    <Button x:Name="BtnStart" Content="启动" Width="100" Height="32" Margin="0,0,8,8" Click="BtnStart_Click" Foreground="#E65100" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnStop" Content="停止" Width="100" Height="32" Margin="0,0,8,8" Click="BtnStop_Click" Foreground="#455A64" FontWeight="SemiBold"/>
                                    <TextBlock Text="运行" VerticalAlignment="Center" Foreground="{StaticResource Ui.TextSecondary}" Margin="0,0,4,8"/>
                                    <TextBlock x:Name="TxtRunStatus" Text="---" VerticalAlignment="Center" Margin="0,0,16,8" Foreground="{StaticResource Ui.TextMuted}" FontFamily="Consolas" FontWeight="Bold"/>
                                    <Button x:Name="BtnEstop" Content="急停" Width="100" Height="32" Margin="0,0,8,8" Click="BtnEstop_Click" Foreground="#C62828" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtEstopStatus" Text="---" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource Ui.TextMuted}" FontFamily="Consolas" FontWeight="Bold"/>
                                </WrapPanel>

                                <!-- X 轴点动 -->
                                <Border Style="{StaticResource PlcInnerPanel}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PlcAccentBar}" Background="#D32F2F"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="X 轴" FontWeight="SemiBold" Foreground="#D32F2F" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnXForward" Content="正转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <Button x:Name="BtnXReverse" Content="反转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <TextBlock x:Name="TxtXRotateStatus" Text="---" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{StaticResource Ui.TextMuted}" FontFamily="Consolas"/>
                                                <Button x:Name="BtnXZero" Content="回零" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="LblXEnable" Text="使能" VerticalAlignment="Center" Foreground="#D32F2F" Margin="8,0,4,0"/>
                                                <Button x:Name="BtnXEnable" Content="开" Width="52" Height="26" Margin="0,0,4,0" Click="BtnXEnable_Click"/>
                                                <Button x:Name="BtnXDisable" Content="关" Width="52" Height="26" Margin="0,0,4,0" Click="BtnXDisable_Click" Foreground="#455A64"/>
                                                <TextBlock x:Name="TxtXEnableStatus" Text="关" VerticalAlignment="Center" Margin="4,0,12,0" FontFamily="Consolas" Foreground="{StaticResource Ui.TextSecondary}"/>
                                                <TextBlock x:Name="LblXAlarm" Text="报警" VerticalAlignment="Center" Foreground="#D32F2F" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnXAlarmClear" Content="清除" Width="52" Height="26" Click="BtnXAlarmClear_Click" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Y 轴点动 -->
                                <Border Style="{StaticResource PlcInnerPanel}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PlcAccentBar}" Background="#1976D2"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Y 轴" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnYForward" Content="正转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <Button x:Name="BtnYReverse" Content="反转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <TextBlock x:Name="TxtYRotateStatus" Text="---" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{StaticResource Ui.TextMuted}" FontFamily="Consolas"/>
                                                <Button x:Name="BtnYZero" Content="回零" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="LblYEnable" Text="使能" VerticalAlignment="Center" Foreground="#1976D2" Margin="8,0,4,0"/>
                                                <Button x:Name="BtnYEnable" Content="开" Width="52" Height="26" Margin="0,0,4,0" Click="BtnYEnable_Click"/>
                                                <Button x:Name="BtnYDisable" Content="关" Width="52" Height="26" Margin="0,0,4,0" Click="BtnYDisable_Click" Foreground="#455A64"/>
                                                <TextBlock x:Name="TxtYEnableStatus" Text="关" VerticalAlignment="Center" Margin="4,0,12,0" FontFamily="Consolas" Foreground="{StaticResource Ui.TextSecondary}"/>
                                                <TextBlock x:Name="LblYAlarm" Text="报警" VerticalAlignment="Center" Foreground="#1976D2" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnYAlarmClear" Content="清除" Width="52" Height="26" Click="BtnYAlarmClear_Click" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Z 轴点动 -->
                                <Border Style="{StaticResource PlcInnerPanel}" CornerRadius="6" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PlcAccentBar}" Background="#388E3C"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Z 轴" FontWeight="SemiBold" Foreground="#388E3C" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnZForward" Content="正转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <Button x:Name="BtnZReverse" Content="反转" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture"/>
                                                <TextBlock x:Name="TxtZRotateStatus" Text="---" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{StaticResource Ui.TextMuted}" FontFamily="Consolas"/>
                                                <Button x:Name="BtnZZero" Content="回零" Width="72" Height="28" Margin="0,0,6,0" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" LostMouseCapture="HoldButton_LostMouseCapture" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="LblZEnable" Text="使能" VerticalAlignment="Center" Foreground="#388E3C" Margin="8,0,4,0"/>
                                                <Button x:Name="BtnZEnable" Content="开" Width="52" Height="26" Margin="0,0,4,0" Click="BtnZEnable_Click"/>
                                                <Button x:Name="BtnZDisable" Content="关" Width="52" Height="26" Margin="0,0,4,0" Click="BtnZDisable_Click" Foreground="#455A64"/>
                                                <TextBlock x:Name="TxtZEnableStatus" Text="关" VerticalAlignment="Center" Margin="4,0,12,0" FontFamily="Consolas" Foreground="{StaticResource Ui.TextSecondary}"/>
                                                <TextBlock x:Name="LblZAlarm" Text="报警" VerticalAlignment="Center" Foreground="#388E3C" Margin="0,0,4,0"/>
                                                <Button x:Name="BtnZAlarmClear" Content="清除" Width="52" Height="26" Click="BtnZAlarmClear_Click" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="工艺与 IO" Style="{StaticResource PlcTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" Padding="8,10,8,4">
                            <StackPanel>
                                <Border Style="{StaticResource PlcInnerPanel}" Padding="8,6" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnLaserToggle" Content="激光" Width="52" Height="26" Foreground="#E65100" FontWeight="SemiBold"
                                                    ToolTip="按住打开激光，松开关闭"
                                                    PreviewMouseLeftButtonDown="BtnLaserToggle_PreviewMouseLeftButtonDown"
                                                    PreviewMouseLeftButtonUp="BtnLaserToggle_PreviewMouseLeftButtonUp"
                                                    LostMouseCapture="BtnLaserToggle_LostMouseCapture"/>
                                            <TextBlock x:Name="TxtLaserEnableStatus" Text="关" VerticalAlignment="Center" Margin="6,0,0,0" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="红光" VerticalAlignment="Center" Foreground="#C62828" Margin="0,0,6,0"/>
                                            <Button x:Name="BtnRedLightEnable" Content="开" Width="36" Height="24" Margin="0,0,4,0" Click="BtnRedLightEnable_Click" Foreground="#C62828"/>
                                            <Button x:Name="BtnRedLightDisable" Content="关" Width="36" Height="24" Click="BtnRedLightDisable_Click"/>
                                            <TextBlock x:Name="TxtRedLightEnableStatus" Text="关" VerticalAlignment="Center" Margin="6,0,0,0" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnBlowToggle" Content="吹气" Width="52" Height="26" Click="BtnBlowToggle_Click" Foreground="#0277BD" FontWeight="SemiBold"
                                                    ToolTip="点击切换吹气使能开/关"/>
                                            <TextBlock x:Name="TxtBlowEnableStatus" Text="关" VerticalAlignment="Center" Margin="6,0,0,0" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <Button x:Name="BtnCameraCaptureStart" Grid.Column="3" Content="相机拍照" Width="80" Height="26" HorizontalAlignment="Right"
                                                Click="BtnCameraCaptureStart_Click" Foreground="#5E35B1" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource PlcSubTitle}" Text="激光参数" Margin="0,0,0,6"/>
                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                        <TextBlock x:Name="LblLaserPower" Text="功率" Width="56" VerticalAlignment="Center" Foreground="#E65100"/>
                                        <TextBox x:Name="TxtLaserPower" Width="56" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                        <Button x:Name="BtnWriteLaserPower" Content="写" Width="28" Height="24" Click="BtnWriteLaserPower_Click" Foreground="#E65100" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                        <TextBlock x:Name="LblLaserActualPower" Text="当前功率" Width="56" VerticalAlignment="Center" Foreground="#E65100"/>
                                        <TextBox x:Name="TxtLaserActualPower" Width="56" Height="24" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                        <TextBlock x:Name="LblLaserInitialPower" Text="初始功率" Width="56" VerticalAlignment="Center" Foreground="#E65100"/>
                                        <TextBox x:Name="TxtLaserInitialPower" Width="56" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                        <Button Content="写" Width="28" Height="24" Tag="LaserInitialPower" Click="BtnWriteConfigFloat_Click" Foreground="#E65100" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock x:Name="LblLaserRampDown" Text="收光自减" Width="56" VerticalAlignment="Center" Foreground="#E65100"/>
                                        <TextBox x:Name="TxtLaserRampDown" Width="56" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                        <Button Content="写" Width="28" Height="24" Tag="LaserRampDown" Click="BtnWriteConfigFloat_Click" Foreground="#E65100" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                        <TextBlock x:Name="LblLaserPowerRampUp" Text="功率自加" Width="56" VerticalAlignment="Center" Foreground="#E65100"/>
                                        <TextBox x:Name="TxtLaserPowerRampUp" Width="56" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
