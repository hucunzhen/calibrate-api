<Window x:Class="CalibOperatorCLI_Example.RoiTangentArcParamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="相切圆弧参数"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30"
        Foreground="#E0E0E0"
        ShowInTaskbar="False">
    <Border Padding="16" MinWidth="360">
        <StackPanel>
            <TextBlock Text="已用鼠标选定圆弧走向；请输入半径与张角。" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="#B0BEC5" FontSize="12"/>
            <TextBlock Text="半径 R" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="像素" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtRadiusPx" Grid.Column="1" Height="26" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtRadiusMm" Grid.Column="3" Height="26" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"/>
            </Grid>
            <TextBlock Text="张角（弧度）" FontWeight="SemiBold" Margin="0,0,0,4"
                       ToolTip="沿选定方向绕圆心转过的角度，单位：度"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="角度" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtSweepDeg" Grid.Column="1" Height="26" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="°" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtArcLengthHint" Grid.Column="3" VerticalAlignment="Center"
                           Foreground="#80CBC4" FontSize="11" TextWrapping="Wrap"/>
            </Grid>
            <TextBlock x:Name="TxtMmStatus" Text="" FontSize="10" Foreground="#888" TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="72" Height="28" Margin="0,0,8,0" IsDefault="True"
                        Click="BtnOk_Click"/>
                <Button Content="取消" Width="72" Height="28" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
