<Window x:Class="CalibOperatorCLI_Example.RoiPrimitiveParamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROI 参数"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30"
        Foreground="#E0E0E0"
        ShowInTaskbar="False">
    <Border Padding="16" MinWidth="400">
        <StackPanel>
            <TextBlock x:Name="TxtHint" Text="输入 ROI 几何参数（世界坐标 mm，由九点标定换算）。" TextWrapping="Wrap"
                       Margin="0,0,0,12" Foreground="#B0BEC5" FontSize="12"/>

            <StackPanel x:Name="PnlRect" Visibility="Collapsed">
                <TextBlock Text="轴对齐矩形" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X (mm)" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRectLeft" Grid.Column="1" Height="26" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Y (mm)" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRectTop" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="W (mm)" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRectWidth" Grid.Column="1" Height="26" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="H (mm)" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRectHeight" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="PnlRotatedRect" Visibility="Collapsed">
                <TextBlock Text="旋转矩形" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="中心X" VerticalAlignment="Center" ToolTip="世界坐标 X (mm)"/>
                    <TextBox x:Name="TxtRotCenterX" Grid.Column="1" Height="26" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="中心Y" VerticalAlignment="Center" ToolTip="世界坐标 Y (mm)"/>
                    <TextBox x:Name="TxtRotCenterY" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="W (mm)" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRotWidth" Grid.Column="1" Height="26" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="H (mm)" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRotHeight" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="角度" VerticalAlignment="Center"
                               ToolTip="0°=沿图像 +X，逆时针为正"/>
                    <TextBox x:Name="TxtRotAngleDeg" Grid.Column="1" Height="26" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="°" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="PnlCircle" Visibility="Collapsed">
                <TextBlock Text="圆形" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="圆心X" VerticalAlignment="Center" ToolTip="世界坐标 X (mm)"/>
                    <TextBox x:Name="TxtCircleCenterX" Grid.Column="1" Height="26" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="圆心Y" VerticalAlignment="Center" ToolTip="世界坐标 Y (mm)"/>
                    <TextBox x:Name="TxtCircleCenterY" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="R (mm)" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCircleRadius" Grid.Column="1" Height="26" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="TxtWorldHint" Text="" FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,8,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="72" Height="28" Margin="0,0,8,0" IsDefault="True" Click="BtnOk_Click"/>
                <Button Content="取消" Width="72" Height="28" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
