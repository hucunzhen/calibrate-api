<Window x:Class="CalibOperatorCLI_Example.RoleChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改密码"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Ui.PanelBackground}"
        Foreground="{StaticResource Ui.TextPrimary}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Ui.DarkLabel}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Ui.DarkComboBox}"/>
    </Window.Resources>
    <StackPanel Margin="20" MinWidth="340">
        <TextBlock Text="修改角色密码" Style="{StaticResource Ui.SectionHeader}" Margin="0,0,0,8"/>
        <TextBlock Text="先选角色，核对当前密码后再设新密码。操作员可以保持空密码。"
                   Foreground="{StaticResource Ui.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="角色" Margin="0,0,0,4"/>
        <ComboBox x:Name="CmbRole" Height="30" Style="{StaticResource Ui.DarkComboBox}" Margin="0,0,0,10"/>
        <TextBlock Text="当前密码" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtCurrent" Height="30" Padding="8,4" Margin="0,0,0,10"
                     Background="{StaticResource Ui.InputBackground}"
                     Foreground="{StaticResource Ui.TextPrimary}"
                     BorderBrush="{StaticResource Ui.InputBorder}"
                     CaretBrush="{StaticResource Ui.TextPrimary}"/>
        <TextBlock Text="新密码" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtNew" Height="30" Padding="8,4" Margin="0,0,0,10"
                     Background="{StaticResource Ui.InputBackground}"
                     Foreground="{StaticResource Ui.TextPrimary}"
                     BorderBrush="{StaticResource Ui.InputBorder}"
                     CaretBrush="{StaticResource Ui.TextPrimary}"/>
        <TextBlock Text="确认新密码" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtConfirm" Height="30" Padding="8,4" Margin="0,0,0,8"
                     Background="{StaticResource Ui.InputBackground}"
                     Foreground="{StaticResource Ui.TextPrimary}"
                     BorderBrush="{StaticResource Ui.InputBorder}"
                     CaretBrush="{StaticResource Ui.TextPrimary}"/>
        <TextBlock x:Name="TxtError" Foreground="{StaticResource Ui.Danger}" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" IsDefault="True" Style="{StaticResource IndustrialToolbarPrimaryButton}"
                    MinWidth="80" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="取消" IsCancel="True" Style="{StaticResource IndustrialToolbarButton}" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
