<Window x:Class="CalibOperatorCLI_Example.RoiScaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="缩放 ROI"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30"
        Foreground="#E0E0E0"
        ShowInTaskbar="False">
    <Border Padding="16" MinWidth="380">
        <StackPanel>
            <TextBlock x:Name="TxtHint" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="#B0BEC5" FontSize="12"
                       Text="绕当前 ROI 中心均匀缩放几何（不改显示）。1 = 不变，1.02 = 放大 2%，0.98 = 缩小 2%。也可填 102%。"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="倍率" VerticalAlignment="Center"
                           ToolTip="相对当前尺寸的比例。大于 1 放大，小于 1 缩小。"/>
                <TextBox x:Name="TxtFactor" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="TxtUnitHint" FontSize="10" Foreground="#888" TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="72" Height="28" Margin="0,0,8,0" IsDefault="True"
                        Click="BtnOk_Click"/>
                <Button Content="取消" Width="72" Height="28" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
