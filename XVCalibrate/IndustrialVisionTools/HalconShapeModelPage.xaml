<Page x:Class="CalibOperatorCLI_Example.HalconShapeModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HALCON 形状模板"
      Background="{StaticResource Ui.PageBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：图像显示 -->
        <Border Grid.Column="0" Background="#1E1E1E" Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Border Grid.Row="0" Background="#2D2D2D" Margin="8" Padding="6">
                    <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnLoadImage" Content="加载图像" Width="80" Height="28" Margin="0,0,8,0" Click="BtnLoadImage_Click"/>
                    <Button x:Name="BtnCameraGrab" Content="摄像头取一帧" Width="100" Height="28" Margin="0,0,8,0"
                            Click="BtnCameraGrab_Click" ToolTip="海康相机同步抓一帧（设备索引见右侧「相机矫正」）"/>
                    <Button x:Name="BtnClearRoi" Content="清除ROI" Width="80" Height="28" Margin="0,0,8,0" Click="BtnClearRoi_Click"/>
                    <Button x:Name="BtnResetView" Content="重置视图" Width="70" Height="28" Margin="0,0,8,0" Click="BtnResetView_Click"/>
                    <Separator Width="1" Background="#555" Margin="4,2"/>
                    <TextBlock Text="绘制模式：" VerticalAlignment="Center" Foreground="#CCC" Margin="8,0,4,0"/>
                    <RadioButton x:Name="RbRectMode" Content="矩形" GroupName="DrawMode" IsChecked="True" 
                                 Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Checked="DrawMode_Changed"/>
                    <RadioButton x:Name="RbCircleMode" Content="圆形" GroupName="DrawMode"
                                 Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Checked="DrawMode_Changed"
                                 ToolTip="按下圆心拖动设置半径，松开完成"/>
                    <RadioButton x:Name="RbPolygonMode" Content="多边形" GroupName="DrawMode"
                                 Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Checked="DrawMode_Changed"/>
                    <RadioButton x:Name="RbRingMode" Content="环形" GroupName="DrawMode"
                                 Foreground="#CCC" VerticalAlignment="Center"
                                 Checked="DrawMode_Changed"
                                 ToolTip="外圈/内圈各绘一圈并单击起点闭合；下一段可选直线或圆弧"/>
                    <Button x:Name="BtnUndoPoint" Content="撤销点" Width="60" Height="28" Margin="8,0,0,0" 
                            Click="BtnUndoPoint_Click" ToolTip="多边形撤销点；环形回退一步 (Ctrl+Z)"/>
                    <Button x:Name="BtnClosePolygon" Content="闭合说明" Width="64" Height="28" Margin="4,0,0,0"
                            Click="BtnClosePolygon_Click" ToolTip="不会自动闭合；≥3 点后须单击第一个顶点（起点）"/>
                    <Separator Width="1" Background="#555" Margin="8,2,4,2"/>
                    <TextBlock Text="下一段：" VerticalAlignment="Center" Foreground="#CCC" Margin="4,0,4,0"/>
                    <RadioButton x:Name="RbNextSegmentLine" Content="直线" GroupName="NextSeg"
                                 Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0" IsChecked="True"/>
                    <RadioButton x:Name="RbNextSegmentArc" Content="圆弧" GroupName="NextSeg"
                                 Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,4,0"
                                 ToolTip="先点终点，再点弧上经过的一点"/>
                    <CheckBox x:Name="ChkTangentJoin" Content="相切" Foreground="#CCC" VerticalAlignment="Center" Margin="4,0,0,0"
                              Checked="TangentJoin_Changed" Unchecked="TangentJoin_Changed"
                              ToolTip="直线→圆弧：与上段共切线，弧可鼓向切线左侧或右侧；圆弧→直线：沿出口切线取点。"/>
                    <Button x:Name="BtnTangentFlipSide" Content="换向" Width="44" Height="28" Margin="4,0,0,0"
                            Visibility="Collapsed" Click="BtnTangentFlipSide_Click"
                            ToolTip="相切圆弧有两种解，切换弧鼓出方向 (快捷键 F)"/>
                    </StackPanel>
                </Border>

                <!-- 图像画布：子元素一律用图像像素坐标；缩放/平移只施加在 ImageCanvas 上 -->
                <Border x:Name="ViewHost" Grid.Row="1" ClipToBounds="True" Background="#2A2A2A"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                        MouseWheel="Canvas_MouseWheel"
                        PreviewMouseRightButtonDown="Canvas_PreviewMouseRightButtonDown"
                        PreviewMouseRightButtonUp="Canvas_PreviewMouseRightButtonUp"
                        KeyDown="Canvas_KeyDown" Focusable="True">
                    <Canvas x:Name="ImageCanvas" Background="Transparent">
                        <Image x:Name="DisplayImage" Stretch="None" IsHitTestVisible="False"/>
                        <Image x:Name="ThresholdOverlayImage" Stretch="None" IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                        <Rectangle x:Name="RoiRect" Stroke="#00FF00" StrokeThickness="2" StrokeDashArray="4,2"
                                   Fill="#2000FF00" Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0"/>
                        <Ellipse x:Name="RoiCircle" Stroke="#00FF00" StrokeThickness="2" StrokeDashArray="4,2"
                                 Fill="#2000FF00" Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0"/>
                        <Polyline x:Name="PolygonLine" Stroke="#FFFF00" StrokeThickness="2"
                                  Visibility="Collapsed" Points=""/>
                        <Polyline x:Name="PolygonRubberAltLine" Stroke="#66FFAA00" StrokeThickness="1.2"
                                  StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Polyline x:Name="PolygonRubberLine" Stroke="#FFAA00" StrokeThickness="1.5"
                                  StrokeDashArray="4,3" Visibility="Collapsed" Points=""/>
                        <Polyline x:Name="RingOuterLine" Stroke="#00FF00" StrokeThickness="2"
                                  Fill="#2000FF00" Visibility="Collapsed" Points=""/>
                        <Polyline x:Name="RingInnerLine" Stroke="#00FFFF" StrokeThickness="2"
                                  Visibility="Collapsed" Points=""/>
                        <Canvas x:Name="FindResultOverlay" IsHitTestVisible="False"/>
                    </Canvas>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧：参数设置 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,8,8,8">
            <StackPanel>
                <!-- 模板来源与模型类型 -->
                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="模板来源" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbTemplateSource" Height="26" Margin="0,0,0,8"
                                  SelectionChanged="CreateOption_Changed">
                            <ComboBoxItem Content="ROI 内灰度阈值 → 轮廓" Tag="ThresholdXld" IsSelected="True"/>
                            <ComboBoxItem Content="ROI 内 Canny 边缘 → 轮廓" Tag="EdgesXld"/>
                            <ComboBoxItem Content="手绘 ROI 边线 (设梯度方向)" Tag="PolygonXld"/>
                            <ComboBoxItem Content="矩形 ROI 灰度图" Tag="ImageRectangle"/>
                            <ComboBoxItem Content="多边形域灰度图" Tag="ImagePolygon"/>
                            <ComboBoxItem Content="测量几何 → 轮廓 (可手调)" Tag="GeometryXld"/>
                        </ComboBox>
                        <TextBlock FontWeight="Bold" Text="模型类型" Margin="0,4,0,6"/>
                        <ComboBox x:Name="CmbModelKind" Height="26" SelectionChanged="CreateOption_Changed">
                            <ComboBoxItem Content="标准形状" Tag="Shape" IsSelected="True"/>
                            <ComboBoxItem Content="缩放形状" Tag="ScaledShape"/>
                            <ComboBoxItem Content="可变形(局部)" Tag="Deformable"/>
                            <ComboBoxItem Content="可变形(透视)" Tag="PlanarDeformable"/>
                        </ComboBox>
                        <TextBlock Text="矩形/圆形/多边形/环形 ROI 可限制提取与图像模板区域；环形=外圈减内圈（均支持直线/圆弧段）" FontSize="10" Foreground="#888" 
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}"
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="相机矫正" Margin="0,0,0,6"/>
                        <TextBlock Text="加载图像后按棋盘标定 JSON 做内参去畸变与/或平面透视展开；创建/匹配均使用矫正后图像。"
                                   FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备索引" VerticalAlignment="Center"
                                       ToolTip="相机枚举序号，从 0 开始"/>
                            <TextBox x:Name="TxtCameraDeviceIndex" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Button x:Name="BtnCameraGrabPanel" Content="摄像头取一帧" Height="28" Margin="0,0,0,8"
                                Click="BtnCameraGrab_Click"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="标定 JSON" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCalibrationJsonPath" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                     ToolTip="棋盘格内参标定输出的 CalibrationJson 文件"/>
                            <Button Grid.Column="2" Content="..." Height="24" Margin="4,0,0,0" Click="BtnBrowseCalibrationJson_Click"/>
                        </Grid>
                        <CheckBox x:Name="ChkEnableUndistort" Content="内参畸变矫正 (undistort)" Foreground="#CCC" Margin="0,4,0,2"/>
                        <Grid Margin="16,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="裁剪 α" VerticalAlignment="Center"
                                       ToolTip="-1=原尺寸；0..1 裁剪黑边"/>
                            <TextBox x:Name="TxtUndistortAlpha" Grid.Column="1" Text="-1" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <CheckBox x:Name="ChkEnablePerspective" Content="透视矫正 (棋盘平面鸟瞰)" Foreground="#CCC" Margin="0,6,0,4"/>
                        <Grid Margin="16,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="视图序号" VerticalAlignment="Center"
                                       ToolTip="extrinsicsPerView 下标，与标定成功图像顺序一致"/>
                            <TextBox x:Name="TxtCalibViewIndex" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="16,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="列" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCalibBoardCols" Grid.Column="1" Text="9" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="行" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCalibBoardRows" Grid.Column="3" Text="6" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="16,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="方格 mm" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCalibSquareSizeMm" Grid.Column="1" Text="25" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="16,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="mm/像素" VerticalAlignment="Center"
                                       ToolTip="输出鸟瞰图尺度：1=1像素1mm"/>
                            <TextBox x:Name="TxtCalibPxPerMm" Grid.Column="1" Text="1" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="16,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输出范围" VerticalAlignment="Center"
                                       ToolTip="board=仅标定板；local=原图仅板内；plane=整图共面鸟瞰(原图大小、均匀缩放)"/>
                            <ComboBox x:Name="CmbPerspectiveOutputFrame" Grid.Column="1" Height="26">
                                <ComboBoxItem Content="仅标定板 (board)" Tag="board" IsSelected="True"/>
                                <ComboBoxItem Content="原图+板内 (local)" Tag="local"/>
                                <ComboBoxItem Content="整图共面 (plane)" Tag="plane"/>
                            </ComboBox>
                        </Grid>
                        <Button x:Name="BtnApplyCameraCorrection" Content="应用相机矫正" Height="28"
                                Click="BtnApplyCameraCorrection_Click"/>
                    </StackPanel>
                </Border>

                <!-- 轮廓 / 边缘提取 -->
                <Border x:Name="PnlGeometryMeasure" Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}"
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="测量与几何轮廓" Margin="0,0,0,6"/>
                        <TextBlock Text="支持矩形/圆/圆弧/三点弧/手绘路径(含弧段)。坐标/半径等同时显示 mm（由九点标定 affine 转换）。"
                                   FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="九点 JSON" VerticalAlignment="Center"
                                       ToolTip="流程「读取/保存标定结果」输出的 calibration_result.json（含 affine）"/>
                            <TextBox x:Name="TxtNinePointCalibPath" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                     TextChanged="NinePointCalibPath_Changed" LostFocus="NinePointCalibPath_Changed"/>
                            <Button Grid.Column="2" Content="..." Height="24" Margin="4,0,0,0" Click="BtnBrowseNinePointCalib_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtMeasureSummary" Text="测量: —" Foreground="#B0BEC5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtGeomMmHints" Text="" Foreground="#80CBC4" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="几何类型" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbGeometryKind" Height="26" Margin="0,0,0,6" SelectionChanged="GeometryParam_Changed">
                            <ComboBoxItem Content="轴对齐矩形" Tag="AxisAlignedRectangle" IsSelected="True"/>
                            <ComboBoxItem Content="旋转矩形" Tag="RotatedRectangle"/>
                            <ComboBoxItem Content="圆" Tag="Circle"/>
                            <ComboBoxItem Content="圆弧(圆心+起止角)" Tag="Arc"/>
                            <ComboBoxItem Content="三点圆弧" Tag="ArcThreePoint"/>
                            <ComboBoxItem Content="手绘路径(含弧段)" Tag="RoiPolyline"/>
                        </ComboBox>
                        <Grid x:Name="RowGeomCenter" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="中心列 X" VerticalAlignment="Center" ToolTip="图像列坐标"/>
                            <TextBox x:Name="TxtGeomCenterCol" Grid.Column="1" Text="0" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="中心行 Y" VerticalAlignment="Center" ToolTip="图像行坐标"/>
                            <TextBox x:Name="TxtGeomCenterRow" Grid.Column="3" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="RowGeomRectSize" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="宽 W(px)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtGeomWidth" Grid.Column="1" Text="100" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="高 H(px)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtGeomHeight" Grid.Column="3" Text="50" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="RowGeomAngle" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="角度(°)" VerticalAlignment="Center" ToolTip="旋转矩形长边方向"/>
                            <TextBox x:Name="TxtGeomAngleDeg" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="RowGeomRadius" Margin="0,0,0,4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="半径 R" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtGeomRadius" Grid.Column="1" Text="40" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="RowGeomArcAngles" Margin="0,0,0,4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="起始角°" VerticalAlignment="Center" ToolTip="0°=图像+X方向"/>
                            <TextBox x:Name="TxtGeomArcStartDeg" Grid.Column="1" Text="0" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="张角°" VerticalAlignment="Center" ToolTip="逆时针为正，可填负值"/>
                            <TextBox x:Name="TxtGeomArcExtentDeg" Grid.Column="3" Text="90" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="RowGeomArc3Start" Margin="0,0,0,4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="起点 X,Y" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtGeomArcStartCol" Grid.Column="1" Text="0" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtGeomArcStartRow" Grid.Column="3" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="RowGeomArc3Via" Margin="0,0,0,4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="弧上 X,Y" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtGeomArcViaCol" Grid.Column="1" Text="50" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtGeomArcViaRow" Grid.Column="3" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="RowGeomArc3End" Margin="0,0,0,4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="终点 X,Y" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtGeomArcEndCol" Grid.Column="1" Text="0" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtGeomArcEndRow" Grid.Column="3" Text="50" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="TxtGeomRoiPathHint" Text="手绘路径：多边形模式绘制并闭合 →「从 ROI 同步」→ 在下方选中段并修改直线/圆弧参数。"
                                   FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>
                        <Border x:Name="PnlGeomPathEditor" Visibility="Collapsed" Background="#1A2528" BorderBrush="#37474F"
                                BorderThickness="1" Padding="8" Margin="0,0,0,6" CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="路径段（可手调）" FontSize="11" Foreground="#90A4AE" Margin="0,0,0,4"/>
                                <ListBox x:Name="LstGeomPathSegments" Height="88" Margin="0,0,0,6"
                                         SelectionChanged="GeomPathSegment_SelectionChanged"/>
                                <TextBlock Text="段类型" FontSize="10" Foreground="#888" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbGeomPathSegKind" Height="24" Margin="0,0,0,4" SelectionChanged="GeomPathSegmentParam_Changed">
                                    <ComboBoxItem Content="直线" Tag="Line" IsSelected="True"/>
                                    <ComboBoxItem Content="圆弧(三点)" Tag="Arc"/>
                                </ComboBox>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="起点X" VerticalAlignment="Center" FontSize="10"/>
                                    <TextBox x:Name="TxtGeomPathStartCol" Grid.Column="1" Height="22" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="起点Y" VerticalAlignment="Center" FontSize="10"/>
                                    <TextBox x:Name="TxtGeomPathStartRow" Grid.Column="3" Height="22" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Grid x:Name="RowGeomPathVia" Margin="0,0,0,4" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="弧上X" VerticalAlignment="Center" FontSize="10"/>
                                    <TextBox x:Name="TxtGeomPathViaCol" Grid.Column="1" Height="22" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="弧上Y" VerticalAlignment="Center" FontSize="10"/>
                                    <TextBox x:Name="TxtGeomPathViaRow" Grid.Column="3" Height="22" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="终点X" VerticalAlignment="Center" FontSize="10"/>
                                    <TextBox x:Name="TxtGeomPathEndCol" Grid.Column="1" Height="22" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="终点Y" VerticalAlignment="Center" FontSize="10"/>
                                    <TextBox x:Name="TxtGeomPathEndRow" Grid.Column="3" Height="22" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Button x:Name="BtnApplyGeomPathSegment" Content="应用本段" Height="26"
                                        Click="BtnApplyGeomPathSegment_Click" ToolTip="写回路径并刷新轮廓预览"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="BtnSyncGeometryFromRoi" Content="从 ROI 同步" Width="96" Height="28" Margin="0,0,8,0"
                                    Click="BtnSyncGeometryFromRoi_Click" ToolTip="矩形/圆/闭合多边形(含弧)/环形外圈"/>
                            <Button x:Name="BtnApplyGeometryParams" Content="应用参数" Width="88" Height="28"
                                    Click="BtnApplyGeometryParams_Click" ToolTip="按参数生成轮廓并叠加预览"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="PnlContourExtract" Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="轮廓提取" Margin="0,0,0,8"/>
                        <TextBlock Text="轮廓生成模式" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbGenContourMode" Height="26" Margin="0,0,0,6">
                            <ComboBoxItem Content="边界" Tag="border" IsSelected="True"/>
                            <ComboBoxItem Content="边界(含孔)" Tag="border_holes"/>
                            <ComboBoxItem Content="中心线" Tag="center"/>
                        </ComboBox>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最少轮廓点数" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMinContourPoints" Grid.Column="1" Text="10" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <CheckBox x:Name="ChkLargestContourOnly" Content="仅保留最长轮廓" Foreground="#CCC" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PnlContourTrim" Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="轮廓修剪" Margin="0,0,0,6"/>
                        <TextBlock Text="先「预览轮廓」，再修剪；创建模型时使用修剪结果" FontSize="10" Foreground="#888" 
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="修剪方式" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbTrimMode" Height="26" Margin="0,0,0,6">
                            <ComboBoxItem Content="简化 (Douglas-Peucker)" Tag="Simplify" IsSelected="True"/>
                            <ComboBoxItem Content="平滑 (SmoothContoursXld)" Tag="Smooth"/>
                            <ComboBoxItem Content="直线/圆弧分段" Tag="Segment"/>
                            <ComboBoxItem Content="裁掉首尾" Tag="TrimEnds"/>
                            <ComboBoxItem Content="删除短轮廓" Tag="FilterMinLength"/>
                        </ComboBox>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="简化 ε" VerticalAlignment="Center" ToolTip="像素容差，越大点越少"/>
                            <TextBox x:Name="TxtTrimEpsilon" Grid.Column="1" Text="2" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="首尾裁剪" VerticalAlignment="Center" ToolTip="沿弧长各裁掉像素"/>
                            <TextBox x:Name="TxtTrimEndsPx" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最短周长" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTrimMinLength" Grid.Column="1" Text="20" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <CheckBox x:Name="ChkTrimClosed" Content="闭合轮廓" IsChecked="True" Foreground="#CCC" Margin="0,2,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnApplyTrim" Content="应用修剪" Width="90" Height="28" Margin="0,0,8,0" Click="BtnApplyTrim_Click"/>
                            <Button x:Name="BtnResetContours" Content="清除修剪" Width="90" Height="28" Click="BtnResetContours_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtContourStats" Text="轮廓: 未提取" Foreground="#888" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PnlRoiBoundaryDir" Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="手绘边线梯度" Margin="0,0,0,6"/>
                        <TextBlock Text="轮廓=手绘闭合边线；外/内圈分别生成带方向 XLD 后合并。环形时内圈梯度可相反或单独设置。" 
                                   FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="外圈梯度" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                        <StackPanel x:Name="PnlGradientPolarity" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="RbGradientOutward" Content="向外" GroupName="GradPol"
                                         Foreground="#CCC" Margin="0,0,12,0" IsChecked="True"
                                         ToolTip="边线法向指向该圈多边形外侧"/>
                            <RadioButton x:Name="RbGradientInward" Content="向内" GroupName="GradPol"
                                         Foreground="#CCC"
                                         ToolTip="边线法向指向该圈多边形内侧"/>
                        </StackPanel>
                        <TextBlock Text="环形内圈梯度（仅环形 ROI）" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbRingInnerGradientMode" Height="26" Margin="0,0,0,6"
                                  SelectionChanged="RingInnerGradientMode_Changed">
                            <ComboBoxItem Content="与外圈相反" Tag="opposite" IsSelected="True"/>
                            <ComboBoxItem Content="与外圈相同" Tag="same"/>
                            <ComboBoxItem Content="单独设置" Tag="custom"/>
                        </ComboBox>
                        <StackPanel x:Name="PnlRingInnerGradientCustom" Orientation="Horizontal" Visibility="Collapsed">
                            <RadioButton x:Name="RbInnerGradientOutward" Content="内圈向外" GroupName="GradPolInner"
                                         Foreground="#CCC" Margin="0,0,12,0" IsChecked="True"/>
                            <RadioButton x:Name="RbInnerGradientInward" Content="内圈向内" GroupName="GradPolInner"
                                         Foreground="#CCC"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="PnlEdgeExtract" Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="Canny 边缘提取" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="平滑" VerticalAlignment="Center" ToolTip="Alpha"/>
                            <TextBox x:Name="TxtEdgeAlpha" Grid.Column="1" Text="1" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="低阈" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtEdgeLow" Grid.Column="1" Text="20" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="高阈" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtEdgeHigh" Grid.Column="1" Text="40" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="在 ROI 区域内做 Canny；与「手绘边线」模式不同" 
                                   FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 缩放模型 -->
                <Border x:Name="PnlScale" Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="缩放范围" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最小缩放" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtScaleMin" Grid.Column="1" Text="0.9" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最大缩放" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtScaleMax" Grid.Column="1" Text="1.1" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="缩放步长" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtScaleStep" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="缩放步长=0 表示自动" FontSize="10" Foreground="#888"/>
                    </StackPanel>
                </Border>

                <!-- 阈值设置 -->
                <Border x:Name="PnlThreshold" Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="阈值设置" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最小灰度" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMinGray" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"
                                     TextChanged="TxtMinGray_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最大灰度" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMaxGray" Grid.Column="1" Text="255" Height="24" VerticalContentAlignment="Center"
                                     TextChanged="TxtMaxGray_TextChanged"/>
                        </Grid>
                        <Button x:Name="BtnAutoThreshold" Content="自动阈值" Width="100" Height="26" Margin="0,4,0,0" 
                                HorizontalAlignment="Left" Click="BtnAutoThreshold_Click"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="起点容差" VerticalAlignment="Center"
                                       ToolTip="单击位置距起点小于该值(像素)时视为点击起点并闭合"/>
                            <TextBox x:Name="TxtPolygonCloseDist" Grid.Column="1" Text="6" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="多边形≥3点后单击起点闭合；下一段选直线/圆弧，勾选「相切」可直线接圆(或圆接直线)自动共切线" FontSize="10" Foreground="#888"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CreateShapeModel 参数 -->
                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="匹配模型参数" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="金字塔层数" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtNumLevels" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"
                                     ToolTip="0 = 自动"/>
                        </Grid>
                        <TextBlock Text="层数 / 角度步长 / 缩放步长：0 = 自动" FontSize="10" Foreground="#888" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="起始角°" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtAngleStart" Grid.Column="1" Text="-30" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="角度范围°" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtAngleExtent" Grid.Column="1" Text="60" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="角度步长°" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtAngleStep" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid x:Name="RowContrast" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="对比度" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtContrast" Grid.Column="1" Text="auto" Height="24" VerticalContentAlignment="Center"
                                     ToolTip="图像模板：auto 或整数阈值"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最小对比度" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMinContrast" Grid.Column="1" Text="10" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="优化" FontSize="11" Foreground="#888" Margin="0,6,0,2"/>
                        <ComboBox x:Name="CmbOptimization" Height="26" Margin="0,0,0,4">
                            <ComboBoxItem Content="自动" Tag="auto" IsSelected="True"/>
                            <ComboBoxItem Content="无" Tag="none"/>
                            <ComboBoxItem Content="点减少-低" Tag="point_reduction_low"/>
                            <ComboBoxItem Content="点减少-中" Tag="point_reduction_medium"/>
                            <ComboBoxItem Content="点减少-高" Tag="point_reduction_high"/>
                        </ComboBox>

                        <TextBlock Text="极性度量" FontSize="11" Foreground="#888" Margin="0,6,0,2"/>
                        <ComboBox x:Name="CmbMetric" Height="26">
                            <ComboBoxItem Content="忽略局部极性" Tag="ignore_local_polarity" IsSelected="True"/>
                            <ComboBoxItem Content="忽略全局极性" Tag="ignore_global_polarity"/>
                            <ComboBoxItem Content="忽略颜色极性" Tag="ignore_color_polarity"/>
                            <ComboBoxItem Content="使用极性" Tag="use_polarity"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 操作按钮 -->
                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <Button x:Name="BtnPreviewContour" Content="预览轮廓 / 模板域" Height="28"
                                Margin="0,0,0,8" Click="BtnPreviewContour_Click"/>
                        <Button x:Name="BtnCreateModel" Content="创建形状模型" Height="32" FontWeight="Bold" 
                                Margin="0,0,0,8" Click="BtnCreateModel_Click"/>

                        <TextBlock Text="形状匹配测试" FontWeight="SemiBold" Margin="0,4,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="匹配个数" VerticalAlignment="Center"
                                       ToolTip="0=按下方阵列行×列（默认 3×3）；填正整数则固定上限；流程中 0 才表示全部"/>
                            <TextBox x:Name="TxtFindNumMatches" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"
                                     ToolTip="测试页 0 不会搜全部匹配，而是按阵列行列或默认 100 封顶"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最低分数" VerticalAlignment="Center"
                                       ToolTip="漏检时降到 0.35~0.45；误检多时提高到 0.55~0.65"/>
                            <TextBox x:Name="TxtFindMinScore" Grid.Column="1" Text="0.4" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="贪婪度" VerticalAlignment="Center"
                                       ToolTip="0~1；漏检时降低(如0.7)，速度慢但更全"/>
                            <TextBox x:Name="TxtFindGreediness" Grid.Column="1" Text="0.75" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="搜索层数" VerticalAlignment="Center"
                                       ToolTip="0=与创建模型一致；建议与创建金字塔层数相同"/>
                            <TextBox x:Name="TxtFindNumLevels" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最大重叠" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtFindMaxOverlap" Grid.Column="1" Text="0.5" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="HALCON 会返回全部候选；流程后接「阵列过滤」后数量更少。下方可勾选以复现流程结果。" 
                                   FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkFindApplyGridFilter" Content="阵列过滤（同 halcon_filter_shape_match_grid）"
                                  Margin="0,0,0,4" IsChecked="False"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="行×列" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtFindGridRows" Grid.Column="1" Text="3" Height="24" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtFindGridCols" Grid.Column="2" Grid.ColumnSpan="2" Text="3" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="保留最低分" VerticalAlignment="Center"
                                       ToolTip="过滤后保留的最低分数，0=不按分数剔除"/>
                            <TextBox x:Name="TxtFindMinScoreKeep" Grid.Column="1" Text="0.45" Height="24" VerticalContentAlignment="Center" ToolTip="0=不按分数剔除"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="阵列角度°" VerticalAlignment="Center"
                                       ToolTip="auto=自动(匹配角+PCA)；或填固定角度"/>
                            <TextBox x:Name="TxtFindGridAngleDeg" Grid.Column="1" Text="auto" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="角度偏差°" VerticalAlignment="Center"
                                       ToolTip="相对匹配角的中位偏差；整板同向可设10~15；对称模板请设0"/>
                            <TextBox x:Name="TxtFindMaxAngleDev" Grid.Column="1" Text="0" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>
                        <CheckBox x:Name="ChkFindAutoRetry" Content="零结果时自动降低最低分数重试"
                                  Margin="0,0,0,6" IsChecked="False"
                                  ToolTip="仅当 HALCON 返回 0 个匹配时再试；有匹配时不会增加数量"/>

                        <Button x:Name="BtnImportModel" Content="导入模型(.shm)" Height="28"
                                Margin="0,0,0,8" Click="BtnImportModel_Click"
                                ToolTip="从文件加载 HALCON 形状模型，可直接测试形状匹配，无需在本页创建"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnTestFind" Grid.Column="0" Content="测试形状匹配" Height="28"
                                    Click="BtnTestFind_Click"/>
                            <Button x:Name="BtnStopFind" Grid.Column="2" Content="停止" Height="28" MinWidth="56"
                                    IsEnabled="False" Visibility="Collapsed" Click="BtnStopFind_Click"
                                    ToolTip="停止当前匹配（HALCON 须结束本轮搜索后 UI 恢复；自动重试会在两轮之间停止）"/>
                        </Grid>
                        <Button x:Name="BtnExportModel" Content="导出模型(.shm)" Height="28" 
                                Margin="0,0,0,8" Click="BtnExportModel_Click"/>
                    </StackPanel>
                </Border>

                <!-- 模型信息 -->
                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="模型信息" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtModelInfo" Text="未创建模型" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 查找结果 -->
                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="查找结果" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtFindResult" Text="无" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border Background="{StaticResource Ui.CardBackground}" BorderBrush="{StaticResource Ui.CardBorder}" 
                        BorderThickness="1" Padding="10" CornerRadius="3">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="日志" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLog" AcceptsReturn="True" MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="#1E1E1E" Foreground="#E0E0E0"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
