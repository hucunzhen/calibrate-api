<Window x:Class="CalibOperatorCLI_Example.FlowLoopRoundPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="循环：选择要执行的轮次"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="560"
        MinHeight="320"
        MaxWidth="980"
        MaxHeight="780"
        Background="#252526"
        Foreground="White"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock x:Name="TxtHint"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Foreground="#CCCCCC"
                   Margin="0,0,0,8"
                   Text="勾选后点「执行所选」跑这些轮，跑完会再次弹出，可重复勾选同一 Index。点「完成循环」才结束选轮，进入循环后的节点。"/>
        <StackPanel x:Name="DisplayInputRow" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="显示输入" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbDisplayInput" MinWidth="180" Height="26" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="全选" MinWidth="64" Height="28" Margin="0,0,8,0" Padding="8,2" Click="SelectAll_Click"/>
                <Button Content="全不选" MinWidth="64" Height="28" Margin="0,0,16,0" Padding="8,2" Click="SelectNone_Click"/>
                <Button Content="执行所选" MinWidth="88" Height="28" Margin="0,0,8,0" Padding="10,2" IsDefault="True" Click="RunSelected_Click"/>
                <Button Content="全部执行" MinWidth="88" Height="28" Margin="0,0,8,0" Padding="10,2" Click="RunAll_Click"/>
                <Button Content="完成循环" MinWidth="88" Height="28" Padding="10,2" IsCancel="True" Click="Finish_Click"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RoundHost"/>
        </ScrollViewer>
    </DockPanel>
</Window>
