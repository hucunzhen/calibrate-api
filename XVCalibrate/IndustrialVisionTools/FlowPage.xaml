<UserControl x:Class="CalibOperatorCLI_Example.FlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="FlowPage_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="FlowToolbarIconBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>
        <Style x:Key="FlowToolbarPrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource FlowToolbarIconBtnStyle}">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#252526">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：算子工具箱 -->
        <Border Grid.Column="0" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="算子工具箱" Foreground="#CCCCCC"
                           FontSize="14" FontWeight="Bold" Margin="10,10,10,4"/>
                <TextBox x:Name="ToolboxFilterBox" DockPanel.Dock="Top"
                         Margin="8,0,8,8" Height="26" Padding="6,2"
                         Background="#2D2D30" Foreground="#DCDCDC"
                         BorderBrush="#555" BorderThickness="1"
                         VerticalContentAlignment="Center"
                         FontSize="12"
                         ToolTip="筛选：显示名 / 类型 Id / 描述（子串匹配）"
                         TextChanged="ToolboxFilter_TextChanged"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="OperatorToolbox" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded}" Margin="0,6,0,0"
                                          Background="#2B2B2E" Foreground="#CCCCCC">
                                    <Expander.Header>
                                        <Border Background="#303033" CornerRadius="4" Padding="6,4">
                                            <TextBlock Text="{Binding Name}" Foreground="#9CDCFE" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Operators}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2D2D30" BorderBrush="#3C3C3C" BorderThickness="1"
                                                        CornerRadius="4" Margin="0,0,0,3" Padding="8,6"
                                                        MouseLeftButtonDown="OperatorItem_MouseLeftButtonDown"
                                                        Cursor="Hand">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#DCDCDC"
                                                                   FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="#858585"
                                                                   FontSize="10" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1" Width="4" Background="#3C3C3C"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- 右侧：流程编排画布 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120" MinHeight="60"/>
            </Grid.RowDefinitions>

            <!-- 工具栏（窄窗口时自动折行） -->
            <Border Grid.Row="0" Background="#2D2D2D" Padding="8,6" BorderBrush="#3C3C3C"
                    BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}"
                            ToolTip="全部运行 (F5)，托管引擎逐节点执行（便于连线查看端口数据）" Click="RunAll_Click"
                            AutomationProperties.Name="全部运行">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="运行" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}"
                            Margin="4,0,0,4"
                            ToolTip="Native 运行：优先使用 C++ NativeFlowEngine；失败则自动回退托管执行"
                            Click="RunAllNative_Click"
                            AutomationProperties.Name="Native 运行">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9F5;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Native" Foreground="#9CDCFE" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopRunButton" Style="{StaticResource FlowToolbarPrimaryBtnStyle}"
                            ToolTip="停止执行" Margin="6,0,0,4" Click="StopRun_Click" IsEnabled="False"
                            Foreground="#FFB3B3"
                            AutomationProperties.Name="停止执行">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="停止" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="6,0,0,4"
                            ToolTip="清空画布" Click="ClearCanvas_Click"
                            AutomationProperties.Name="清空画布">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="UndoFlowButton" Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="4,0,0,4"
                            ToolTip="撤销 (Ctrl+Z)" Click="UndoFlow_Click" IsEnabled="False"
                            AutomationProperties.Name="撤销">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="RedoFlowButton" Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="4,0,0,4"
                            ToolTip="重做 (Ctrl+Y)" Click="RedoFlow_Click" IsEnabled="False"
                            AutomationProperties.Name="重做">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A6;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="4,0,0,4"
                            ToolTip="自动布局" Click="AutoLayout_Click"
                            AutomationProperties.Name="自动布局">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Separator Width="1" Background="#555" Margin="10,4,10,8"/>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}"
                            ToolTip="保存流程" Click="SaveFlow_Click"
                            Foreground="#B8F4B8"
                            AutomationProperties.Name="保存流程">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="保存" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}" Margin="6,0,0,4"
                            ToolTip="加载流程（当前标签）" Click="LoadFlow_Click"
                            Foreground="#B8F4B8"
                            AutomationProperties.Name="加载流程">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="加载" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}" Margin="6,0,0,4"
                            ToolTip="在新标签打开流程" Click="LoadFlowNewTab_Click"
                            Foreground="#C8FFC8"
                            AutomationProperties.Name="在新标签打开流程">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="新标签" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Background="#555" Margin="10,4,10,8"/>
                    <TextBlock x:Name="StatusText" Text="就绪" Foreground="#9CDCFE"
                               VerticalAlignment="Center" FontSize="12" Margin="0,4,0,4"/>
                    <Separator Width="1" Background="#555" Margin="10,4,10,8"/>
                    <Button Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="4,0,0,4"
                            ToolTip="清空日志" Click="ClearLog_Click" Foreground="#AAA"
                            AutomationProperties.Name="清空日志">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B9;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- 画布（右下角快捷键提示）；裁剪变换溢出，避免露出外层固定底色 -->
            <Grid Grid.Row="1" ClipToBounds="True" Background="#1E1E1E">
                <Canvas x:Name="FlowCanvas" Background="#1E1E1E"
                        AllowDrop="True"
                        DragOver="FlowCanvas_DragOver"
                        Drop="FlowCanvas_Drop"
                        MouseLeftButtonDown="FlowCanvas_MouseLeftButtonDown"
                        MouseMove="FlowCanvas_MouseMove"
                        MouseLeftButtonUp="FlowCanvas_MouseLeftButtonUp"
                        PreviewMouseRightButtonDown="FlowCanvas_PreviewMouseRightButtonDown"
                        PreviewMouseMove="FlowCanvas_PreviewMouseMove"
                        PreviewMouseRightButtonUp="FlowCanvas_PreviewMouseRightButtonUp"
                        MouseWheel="FlowCanvas_MouseWheel">
                    <Canvas.Resources>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="StrokeThickness" Value="3"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Resources>
                </Canvas>
                <TextBlock Text="滚轮缩放 · 右键拖拽平移画布"
                           VerticalAlignment="Bottom" HorizontalAlignment="Right"
                           Margin="10" Padding="6,4" Background="#66000000" Foreground="#909090"
                           FontSize="11" IsHitTestVisible="False"/>
            </Grid>

            <!-- 日志分隔线 -->
            <GridSplitter Grid.Row="2" Height="3" Background="#3C3C3C"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

            <!-- 日志区域：可选择的 TextBox 方便复制 -->
            <TextBox x:Name="LogBox" Grid.Row="3"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#1E1E1E" Foreground="#CCCCCC" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11" Padding="6,4"
                     Text="就绪"/>
        </Grid>
    </Grid>
</UserControl>
