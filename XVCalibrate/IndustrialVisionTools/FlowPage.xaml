<UserControl x:Class="CalibOperatorCLI_Example.FlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CalibOperatorCLI_Example"
             PreviewKeyDown="FlowPage_PreviewKeyDown">
    <UserControl.Resources>
        <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility"/>
        <conv:SubtractDoubleConverter x:Key="ToolboxDescMaxWidth" Offset="36"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource Ui.WorkspaceBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：算子工具箱 -->
        <Border Grid.Column="0" Background="{StaticResource Ui.PanelBackground}" BorderBrush="{StaticResource Ui.PanelBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="算子工具箱" Style="{StaticResource Ui.SectionHeader}"
                           Margin="12,12,12,4"/>
                <TextBox x:Name="ToolboxFilterBox" DockPanel.Dock="Top"
                         Margin="10,0,10,10" Height="28" Style="{StaticResource Ui.DarkTextBox}"
                         ToolTip="筛选：显示名 / 类型 Id / 描述（子串匹配）"
                         TextChanged="ToolboxFilter_TextChanged"/>
                <ScrollViewer x:Name="OperatorToolboxScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="OperatorToolbox" Margin="4" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded}" Margin="0,4,0,0"
                                          Background="Transparent" Foreground="{StaticResource Ui.TextPrimary}">
                                    <Expander.Header>
                                        <Border Background="{StaticResource Ui.CardDark}" CornerRadius="4" Padding="8,5">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ui.SectionTitle}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Operators}" Margin="0,4,0,0"
                                                  HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Ui.InputBackground}" BorderBrush="{StaticResource Ui.PanelBorder}" BorderThickness="1"
                                                        CornerRadius="4" Margin="0,0,0,4" Padding="8,5"
                                                        HorizontalAlignment="Stretch"
                                                        MouseLeftButtonDown="OperatorItem_MouseLeftButtonDown"
                                                        Cursor="Hand"
                                                        ToolTipService.ShowDuration="60000">
                                                    <Border.ToolTip>
                                                        <StackPanel MaxWidth="280">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                                                       Foreground="White" FontSize="12"/>
                                                            <TextBlock Text="{Binding TypeId}" Foreground="#888888"
                                                                       FontSize="10" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="#CCCCCC"
                                                                       FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border.ToolTip>
                                                    <StackPanel HorizontalAlignment="Stretch">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Ui.TextPrimary}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource Ui.PanelBorder}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- 右侧：流程编排画布 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120" MinHeight="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Ui.PanelBackground}" Padding="10,8" BorderBrush="{StaticResource Ui.PanelBorder}"
                    BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlowToolbarRunBtnStyle}"
                            ToolTip="全部运行 (F5)，托管引擎逐节点执行（便于连线查看端口数据）" Click="RunAll_Click"
                            AutomationProperties.Name="全部运行">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="运行" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}"
                            Margin="4,0,0,4"
                            ToolTip="Native 运行：优先使用 C++ NativeFlowEngine；失败则自动回退托管执行"
                            Click="RunAllNative_Click"
                            AutomationProperties.Name="Native 运行">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9F5;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Native" Foreground="#9CDCFE" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}"
                            Margin="4,0,0,4"
                            ToolTip="干跑：仅检查连线与执行顺序，不实际执行算子"
                            Click="DryRun_Click"
                            AutomationProperties.Name="干跑">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="干跑" Foreground="#FFD580" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopRunButton" Style="{StaticResource FlowToolbarPrimaryBtnStyle}"
                            ToolTip="停止执行" Margin="6,0,0,4" Click="StopRun_Click" IsEnabled="False"
                            Foreground="#FFB3B3"
                            AutomationProperties.Name="停止执行">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="停止" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="6,0,0,4"
                            ToolTip="清空画布" Click="ClearCanvas_Click"
                            AutomationProperties.Name="清空画布">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="UndoFlowButton" Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="4,0,0,4"
                            ToolTip="撤销 (Ctrl+Z)" Click="UndoFlow_Click" IsEnabled="False"
                            AutomationProperties.Name="撤销">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="RedoFlowButton" Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="4,0,0,4"
                            ToolTip="重做 (Ctrl+Y)" Click="RedoFlow_Click" IsEnabled="False"
                            AutomationProperties.Name="重做">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A6;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="4,0,0,4"
                            ToolTip="自动布局" Click="AutoLayout_Click"
                            AutomationProperties.Name="自动布局">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Separator Width="1" Background="#555" Margin="10,4,10,8"/>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}"
                            ToolTip="保存流程到当前文件（未命名时等同另存为）" Click="SaveFlow_Click"
                            Foreground="#B8F4B8"
                            AutomationProperties.Name="保存流程">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="保存" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}" Margin="6,0,0,4"
                            ToolTip="将流程保存到新文件" Click="SaveFlowAs_Click"
                            Foreground="#B8F4B8"
                            AutomationProperties.Name="流程另存为">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE792;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="另存为" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}" Margin="6,0,0,4"
                            ToolTip="加载流程（当前标签）" Click="LoadFlow_Click"
                            Foreground="#B8F4B8"
                            AutomationProperties.Name="加载流程">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="加载" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}" Margin="6,0,0,4"
                            ToolTip="在新标签打开流程" Click="LoadFlowNewTab_Click"
                            Foreground="#C8FFC8"
                            AutomationProperties.Name="在新标签打开流程">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="新标签" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}" Margin="6,0,0,4"
                            ToolTip="新建空白流程（新标签）；无多标签宿主时重置当前页为未命名" Click="NewFlowTab_Click"
                            Foreground="#D4E8FF"
                            AutomationProperties.Name="新建流程">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EA;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="新建流程" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlowToolbarPrimaryBtnStyle}" Margin="6,0,0,4"
                            ToolTip="打开帮助文档（flows/README_workflow_guide.md 或同目录 README）"
                            Click="OpenFlowHelp_Click"
                            AutomationProperties.Name="帮助">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="帮助" Foreground="#D4E8FF" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Background="#555" Margin="10,4,10,8"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,4,8,4"
                                ToolTip="写入 flow Meta；HALCON 落格算子 gridRows/gridCols 留空或 0 时继承">
                        <TextBlock Text="阵列行列" Foreground="#B8D4A8" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="行" Foreground="#AAA" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="LatticeGridRowsBox" Width="36" Height="24"
                                 VerticalContentAlignment="Center" FontSize="11"
                                 LostFocus="LatticeGridConfig_LostFocus"/>
                        <TextBlock Text="列" Foreground="#AAA" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox x:Name="LatticeGridColsBox" Width="36" Height="24"
                                 VerticalContentAlignment="Center" FontSize="11"
                                 LostFocus="LatticeGridConfig_LostFocus"/>
                    </StackPanel>
                    <Separator Width="1" Background="#555" Margin="10,4,10,8"/>
                    <StackPanel x:Name="StandaloneDebugPanel" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,4,8,4"
                                Visibility="Collapsed" ToolTip="含组合绑定入/出的子流程：F5 使用此处测试图模拟父组合输入">
                        <TextBlock Text="子流程调试图" Foreground="#E8C070" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="StandaloneDebugImageBox" Width="220" Height="24"
                                 VerticalContentAlignment="Center" FontSize="11"
                                 ToolTip="相对当前 .flow.json 目录；运行前注入 composite_bind_in"/>
                        <Button Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="4,0,0,0"
                                Content="…" Width="28" Height="24"
                                ToolTip="选择调试图像" Click="StandaloneDebugBrowseImage_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource Ui.SectionTitle}"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,4"/>
                    <Separator Width="1" Background="#555" Margin="10,4,10,8"/>
                    <Button Style="{StaticResource FlowToolbarIconBtnStyle}" Margin="4,0,0,4"
                            ToolTip="清空日志" Click="ClearLog_Click" Foreground="#AAA"
                            AutomationProperties.Name="清空日志">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B9;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- 画布（右下角快捷键提示）；裁剪变换溢出，避免露出外层固定底色 -->
            <Grid Grid.Row="1" ClipToBounds="True" Background="#141820">
                <Canvas x:Name="FlowCanvas" Background="#141820"
                        AllowDrop="True"
                        DragOver="FlowCanvas_DragOver"
                        Drop="FlowCanvas_Drop"
                        MouseLeftButtonDown="FlowCanvas_MouseLeftButtonDown"
                        MouseMove="FlowCanvas_MouseMove"
                        MouseLeftButtonUp="FlowCanvas_MouseLeftButtonUp"
                        PreviewMouseRightButtonDown="FlowCanvas_PreviewMouseRightButtonDown"
                        PreviewMouseMove="FlowCanvas_PreviewMouseMove"
                        PreviewMouseRightButtonUp="FlowCanvas_PreviewMouseRightButtonUp"
                        MouseWheel="FlowCanvas_MouseWheel">
                    <Canvas.Resources>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="StrokeThickness" Value="3"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Resources>
                </Canvas>
                <TextBlock Text="滚轮缩放 · 右键拖拽平移画布"
                           VerticalAlignment="Bottom" HorizontalAlignment="Right"
                           Margin="10" Padding="6,4" Background="#66000000" Foreground="#909090"
                           FontSize="11" IsHitTestVisible="False"/>
            </Grid>

            <!-- 日志分隔线 -->
            <GridSplitter Grid.Row="2" Height="3" Background="{StaticResource Ui.PanelBorder}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

            <TextBox x:Name="LogBox" Grid.Row="3"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource Ui.StatusBarBg}" Foreground="{StaticResource Ui.LogConsoleFg}" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11" Padding="8,6"
                     Text="就绪"/>
        </Grid>
    </Grid>
</UserControl>
