<Window x:Class="CalibOperatorCLI_Example.RoiOffsetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="偏移轨迹"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinWidth="320">
    <StackPanel Margin="16" Width="300">
        <TextBlock x:Name="TxtUnitHint" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#555"/>
        <TextBlock Text="偏移距离" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtDistance" Margin="0,4,0,10"/>
        <TextBlock Text="方向（沿轨迹前进）" FontWeight="SemiBold"/>
        <RadioButton x:Name="RbLeft" Content="左侧" IsChecked="True" Margin="0,4,0,0"/>
        <RadioButton x:Name="RbRight" Content="右侧" Margin="0,4,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="72" IsDefault="True" Click="BtnOk_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
